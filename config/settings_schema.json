[
  {
    "name": "theme_info",
    "theme_name": "Kinetic",
    "theme_version": "0.1.0",
    "theme_author": "RJGJ",
    "theme_documentation_url": "https://github.com/RJGJ/shopify-sports-apparel-theme",
    "theme_support_url": "https://github.com/RJGJ/shopify-sports-apparel-theme/issues"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "select",
        "id": "color_scheme",
        "label": "Color scheme",
        "options": [
          { "value": "volt_night", "label": "Volt Night" },
          { "value": "paper", "label": "Paper" },
          { "value": "cobalt", "label": "Cobalt" },
          { "value": "sherbet", "label": "Sherbet" },
          { "value": "forest", "label": "Forest" },
          { "value": "custom", "label": "Custom" }
        ],
        "default": "volt_night"
      },
      {
        "type": "header",
        "content": "Custom colors",
        "info": "Only used when the color scheme is set to Custom."
      },
      { "type": "color", "id": "custom_background", "label": "Background", "default": "#0E0E0C" },
      { "type": "color", "id": "custom_text", "label": "Text", "default": "#F4F2EC" },
      { "type": "color", "id": "custom_accent", "label": "Accent", "default": "#D4FF3A" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "font_pairing",
        "label": "Font pairing",
        "options": [
          { "value": "bold_grotesk", "label": "Bold Grotesk (Archivo + Space Mono)" },
          { "value": "modern_sans", "label": "Modern Sans (Bricolage Grotesque + DM Sans)" },
          { "value": "editorial_serif", "label": "Editorial Serif (Playfair Display + Work Sans)" },
          { "value": "condensed", "label": "Condensed (Anton + Inter)" },
          { "value": "wide_geometric", "label": "Wide Geometric (Unbounded + Nunito Sans)" }
        ],
        "default": "bold_grotesk"
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "Uppercase headings",
        "default": true
      }
    ]
  },
  {
    "name": "Shape",
    "settings": [
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 28,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "hard_shadow",
        "label": "Offset hard shadows",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "info": "In your store currency, e.g. 250. Set to 0 to hide the progress meter.",
        "default": 250
      }
    ]
  },
  {
    "name": "Store details",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "32 x 32px PNG" },
      { "type": "textarea", "id": "store_address", "label": "Store address", "default": "[STORE ADDRESS]" },
      { "type": "text", "id": "support_email", "label": "Support email", "default": "[SUPPORT EMAIL]" },
      { "type": "text", "id": "shipping_days", "label": "Ships in (business days)", "default": "2-4" },
      { "type": "text", "id": "return_window", "label": "Return window (days)", "default": "30" },
      { "type": "text", "id": "fabric_gsm", "label": "Fabric weight", "default": "400gsm" },
      { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons in footer", "default": true }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" }
    ]
  }
]
