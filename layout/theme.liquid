<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    {%- if page_description %}
      <meta property="og:description" content="{{ page_description | escape }}">
    {%- endif %}
    {%- if page_image %}
      <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
      <meta property="og:image:secure_url" content="{{ page_image | image_url: width: 1200 }}">
    {%- endif %}
    <meta name="twitter:card" content="summary_large_image">

    {% render 'font-faces' %}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      window.KINETIC = window.KINETIC || {};
      window.KINETIC.routes = {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        cartUpdate: {{ routes.cart_update_url | json }},
        search: {{ routes.search_url | json }},
        predictiveSearch: {{ routes.predictive_search_url | json }}
      };
      window.KINETIC.currency = {{ cart.currency.iso_code | default: shop.currency | json }};
      window.KINETIC.locale = {{ request.locale.iso_code | json }};
      window.KINETIC.cartType = {{ settings.cart_type | json }};
      window.KINETIC.freeShippingThreshold = {{ settings.free_shipping_threshold | default: 0 | times: 100 | json }};
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
    <script src="{{ 'global.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
