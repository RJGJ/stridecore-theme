{%- doc -%}
  Emits @font-face rules (self-hosted latin woff2 from assets/) for the font
  pairing chosen in theme settings, and preloads the display font.
{%- enddoc -%}

{%- case settings.font_pairing -%}
  {%- when 'modern_sans' -%}
    <link rel="preload" href="{{ 'font-bricolage-grotesque.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face { font-family: 'Bricolage Grotesque'; font-weight: 400 800; font-display: swap; src: url({{ 'font-bricolage-grotesque.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'DM Sans'; font-weight: 400 800; font-display: swap; src: url({{ 'font-dm-sans.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'DM Mono'; font-weight: 400; font-display: swap; src: url({{ 'font-dm-mono-400.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'DM Mono'; font-weight: 500; font-display: swap; src: url({{ 'font-dm-mono-500.woff2' | asset_url }}) format('woff2'); }
    </style>
  {%- when 'editorial_serif' -%}
    <link rel="preload" href="{{ 'font-playfair-display.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face { font-family: 'Playfair Display'; font-weight: 700 900; font-display: swap; src: url({{ 'font-playfair-display.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Work Sans'; font-weight: 400 800; font-display: swap; src: url({{ 'font-work-sans.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'IBM Plex Mono'; font-weight: 400; font-display: swap; src: url({{ 'font-ibm-plex-mono-400.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'IBM Plex Mono'; font-weight: 700; font-display: swap; src: url({{ 'font-ibm-plex-mono-700.woff2' | asset_url }}) format('woff2'); }
    </style>
  {%- when 'condensed' -%}
    <link rel="preload" href="{{ 'font-anton.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face { font-family: 'Anton'; font-weight: 400; font-display: swap; src: url({{ 'font-anton.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Inter'; font-weight: 400 800; font-display: swap; src: url({{ 'font-inter.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'JetBrains Mono'; font-weight: 400 700; font-display: swap; src: url({{ 'font-jetbrains-mono.woff2' | asset_url }}) format('woff2'); }
    </style>
  {%- when 'wide_geometric' -%}
    <link rel="preload" href="{{ 'font-unbounded.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face { font-family: 'Unbounded'; font-weight: 400 900; font-display: swap; src: url({{ 'font-unbounded.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Nunito Sans'; font-weight: 400 800; font-display: swap; src: url({{ 'font-nunito-sans.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Space Mono'; font-weight: 400; font-display: swap; src: url({{ 'font-space-mono-400.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Space Mono'; font-weight: 700; font-display: swap; src: url({{ 'font-space-mono-700.woff2' | asset_url }}) format('woff2'); }
    </style>
  {%- else -%}
    <link rel="preload" href="{{ 'font-archivo.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face { font-family: 'Archivo'; font-weight: 100 900; font-stretch: 62% 125%; font-display: swap; src: url({{ 'font-archivo.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Space Mono'; font-weight: 400; font-display: swap; src: url({{ 'font-space-mono-400.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Space Mono'; font-weight: 700; font-display: swap; src: url({{ 'font-space-mono-700.woff2' | asset_url }}) format('woff2'); }
    </style>
{%- endcase -%}
