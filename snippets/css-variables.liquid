{%- doc -%}
  Emits the KINETIC design tokens: one rule per color scheme, font faces from
  the font pickers, and shape tokens. The default scheme is applied on :root;
  any section can opt into another scheme with the class "color-<scheme id>".
{%- enddoc -%}

{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_body_font
  assign accent_font = settings.type_accent_font
  assign body_bold = body_font | font_modify: 'weight', 'bold'
  assign body_italic = body_font | font_modify: 'style', 'italic'
  assign body_bold_italic = body_bold | font_modify: 'style', 'italic'

  assign radius = settings.corner_radius | default: 0
  assign radius_img = radius | at_most: 18
  if radius > 0
    assign radius_pill = '999px'
  else
    assign radius_pill = '0px'
  endif
-%}

<link rel="preload" as="font" href="{{ heading_font | font_url }}" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="{{ body_font | font_url }}" type="font/woff2" crossorigin>

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_bold | font_face: font_display: 'swap' }}
  {{ body_italic | font_face: font_display: 'swap' }}
  {{ body_bold_italic | font_face: font_display: 'swap' }}
  {{ accent_font | font_face: font_display: 'swap' }}

  {% for scheme in settings.color_schemes -%}
    {%- if scheme.id == settings.default_color_scheme.id -%}
      :root,
    {%- endif -%}
    .color-{{ scheme.id }} {
      {%- render 'color-scheme-vars', scheme: scheme -%}
    }
  {% endfor %}

  :root {
    --r: {{ radius }}px;
    --r-pill: {{ radius_pill }};
    --r-img: {{ radius_img }}px;

    --f-display: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --f-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --f-mono: {{ accent_font.family }}, {{ accent_font.fallback_families }};
    --d-weight: {{ heading_font.weight }};
    --d-stretch: 100%;
    --d-track: -0.04em;
    --d-lead: 0.92;
    --h-case: {% if settings.heading_uppercase %}uppercase{% else %}none{% endif %};

    --page-max: 1360px;
    --gutter: clamp(16px, 4vw, 40px);
  }

  [class*='color-scheme-'] {
    background: var(--bg);
    color: var(--fg);
  }
</style>
