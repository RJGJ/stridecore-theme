{%- doc -%}
  Pickup availability for a variant, built on variant.store_availabilities.
  Shows the closest location and a dialog listing every pickup location.
  Rendered inside the pickup_availability block and by the pickup-availability
  section, which <product-form> fetches when the variant changes.

  @param {variant} product_variant - the variant to check

  @example
  {% render 'product-pickup', product_variant: current %}
{%- enddoc -%}

{%- liquid
  assign pick_ups = product_variant.store_availabilities | where: 'pick_up_enabled', true
  assign closest = pick_ups.first
-%}

{%- if pick_ups.size > 0 -%}
  <div class="pk">
    <p class="pk__line{% if closest.available %} pk__line--ok{% endif %}">
      {%- if closest.available -%}
        {% render 'icon', name: 'check', size: 18 %}
        <span>{{ 'pdp.pickup.available_at_html' | t: location_name: closest.location.name }}</span>
      {%- else -%}
        <span>{{ 'pdp.pickup.unavailable_at_html' | t: location_name: closest.location.name }}</span>
      {%- endif -%}
    </p>
    {%- if closest.available -%}
      <p class="pk__time">{{ closest.pick_up_time }}</p>
    {%- endif -%}
    {%- if pick_ups.size > 1 or closest.available -%}
      <button type="button" class="pk__link" data-pickup-open aria-haspopup="dialog">
        {%- if pick_ups.size == 1 -%}
          {{ 'pdp.pickup.view_store_info' | t }}
        {%- else -%}
          {{ 'pdp.pickup.check_other_stores' | t }}
        {%- endif -%}
      </button>
    {%- endif -%}

    <dialog class="pk__dialog" data-pickup-dialog aria-labelledby="pickup-heading-{{ product_variant.id }}">
      <div class="pk__head">
        <h2 class="pk__title" id="pickup-heading-{{ product_variant.id }}">{{ product_variant.product.title | escape }}</h2>
        <button type="button" class="icon-btn" data-pickup-close aria-label="{{ 'general.close' | t }}">
          {% render 'icon', name: 'close', size: 24 %}
        </button>
      </div>
      {%- unless product_variant.product.has_only_default_variant -%}
        <p class="pk__variant">{{ product_variant.title | escape }}</p>
      {%- endunless -%}
      <ul class="pk__list" role="list">
        {%- for availability in pick_ups -%}
          <li class="pk__item">
            <h3 class="pk__name">{{ availability.location.name | escape }}</h3>
            <p class="pk__status">
              {%- if availability.available -%}
                {{ 'pdp.pickup.available' | t }}, {{ availability.pick_up_time | downcase }}
              {%- else -%}
                {{ 'pdp.pickup.unavailable' | t }}
              {%- endif -%}
            </p>
            {%- assign address = availability.location.address -%}
            <address class="pk__address">
              {{ address | format_address }}
              {%- if address.phone != blank -%}
                <p>{{ address.phone }}</p>
              {%- endif -%}
            </address>
          </li>
        {%- endfor -%}
      </ul>
    </dialog>
  </div>
{%- endif -%}

{% stylesheet %}
  .pk {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
  }
  .pk__line {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-weight: 700;
  }
  .pk__time {
    margin: 0;
    color: var(--muted);
  }
  .pk__link {
    align-self: flex-start;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .pk__dialog {
    width: min(480px, 100vw);
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 24px;
    border: 0;
    border-left: 2px solid var(--fg);
    background: var(--bg);
    color: var(--fg);
    overflow-y: auto;
  }
  .pk__dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  .pk__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .pk__title {
    margin: 0;
    font-size: 22px;
  }
  .pk__variant {
    margin: 8px 0 0;
    color: var(--muted);
  }
  .pk__list {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .pk__item {
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .pk__name {
    margin: 0 0 4px;
    font-size: 16px;
  }
  .pk__status {
    margin: 0 0 8px;
    font-weight: 700;
  }
  .pk__address {
    font-style: normal;
    color: var(--muted);
  }
  .pk__address p {
    margin: 4px 0 0;
  }
{% endstylesheet %}
