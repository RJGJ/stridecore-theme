{%- liquid
  assign hero_style = section.settings.style
  assign hero_loading = 'lazy'
  if section.index < 3
    assign hero_loading = 'eager'
  endif
  assign primary_url = section.settings.primary_link
  if primary_url == blank
    assign primary_url = routes.all_products_collection_url
  endif
  assign secondary_url = section.settings.secondary_link
  if secondary_url == blank
    assign secondary_url = routes.all_products_collection_url
  endif
  assign badge_text = section.settings.badge_text | escape
  assign path_id = 'hero-circ-' | append: section.id
  assign label_image_1 = 'home.hero.image_1_label' | t
  assign label_image_2 = 'home.hero.image_2_label' | t
  assign label_image_full = 'home.hero.image_full_label' | t
-%}

<div
  class="hero hero--{{ hero_style }} color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="--hero-pt: {{ section.settings.padding_top }}; --hero-pb: {{ section.settings.padding_bottom }};"
>
  {%- if hero_style == 'split' -%}
    <div class="hero__split-text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="display hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.body != blank -%}
        <div class="hero__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
      <div class="hero__buttons">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ primary_url }}" class="btn btn--accent">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ secondary_url }}" class="btn">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="hero__split-media">
      {% render 'placeholder-media',
        image: section.settings.split_image,
        label: label_image_full,
        tone: 'accent',
        sizes: '(min-width: 960px) 50vw, 100vw',
        loading: hero_loading
      %}
    </div>
  {%- else -%}
    <div class="container hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <div class="eyebrow hero__eyebrow">
          <span class="hero__dot" aria-hidden="true"></span>
          <span>{{ section.settings.eyebrow }}</span>
        </div>
      {%- endif -%}
      <h1 class="display hero__title">{{ section.settings.heading }}</h1>
      <div class="hero__lower">
        <div class="hero__copy">
          {%- if section.settings.body != blank -%}
            <div class="hero__body rte">{{ section.settings.body }}</div>
          {%- endif -%}
          <div class="hero__buttons">
            {%- if section.settings.primary_label != blank -%}
              <a href="{{ primary_url }}" class="btn btn--accent">{{ section.settings.primary_label }} {% render 'icon', name: 'arrow-right', size: 18, stroke: 2.5 %}</a>
            {%- endif -%}
            {%- if section.settings.secondary_label != blank -%}
              <a href="{{ secondary_url }}" class="btn">{{ section.settings.secondary_label }}</a>
            {%- endif -%}
          </div>
        </div>
        <div class="hero__images">
          <div class="hero__img hero__img--1">
            {% render 'placeholder-media',
              image: section.settings.image_1,
              ratio: '4 / 5',
              label: label_image_1,
              tone: 'surface',
              sizes: '(min-width: 960px) 25vw, 50vw',
              loading: hero_loading
            %}
          </div>
          <div class="hero__img hero__img--2">
            {% render 'placeholder-media',
              image: section.settings.image_2,
              ratio: '4 / 5',
              label: label_image_2,
              tone: 'accent',
              sizes: '(min-width: 960px) 25vw, 50vw',
              loading: hero_loading
            %}
          </div>
          {%- if badge_text != blank or section.settings.badge_number != blank -%}
            <div class="hero__badge">
              <svg class="spin" aria-hidden="true" focusable="false" width="120" height="120" viewBox="0 0 120 120">
                <defs><path id="{{ path_id }}" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"></path></defs>
                <text style="font-family: var(--f-mono)" font-size="11" font-weight="700" letter-spacing="3" fill="currentColor"><textPath href="#{{ path_id }}">{{ badge_text }} • {{ badge_text }} •</textPath></text>
              </svg>
              <span class="hero__badge-num">{{ section.settings.badge_number }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.hero__title {
  font-size: clamp(60px, 12vw, 190px);
}
.hero__title em {
  display: inline-block;
  padding: 0 0.12em;
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--r);
  box-shadow: 0 0 0 3px var(--accent-edge);
  font-style: normal;
  transform: rotate(-2deg);
}
.hero__body {
  font-size: 19px;
  line-height: 1.5;
  color: var(--muted);
}
.hero__body.rte {
  max-width: 460px;
}
.hero__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}
.hero--giant-type .hero__inner {
  padding-top: calc(var(--hero-pt) * 0.6px);
  padding-bottom: calc(var(--hero-pb) * 0.6px);
}
@media (min-width: 750px) {
  .hero--giant-type .hero__inner {
    padding-top: calc(var(--hero-pt) * 1px);
    padding-bottom: calc(var(--hero-pb) * 1px);
  }
}
.hero__eyebrow {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}
.hero__dot {
  width: 10px;
  height: 10px;
  flex: none;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 1px var(--fg);
}
.hero__lower {
  margin-top: clamp(32px, 4vw, 56px);
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
  gap: 32px;
  align-items: end;
}
.hero__copy {
  display: flex;
  flex-direction: column;
  gap: 28px;
  max-width: 460px;
}
.hero__images {
  position: relative;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  padding-top: 24px;
}
.hero__img .media {
  border: 2px solid var(--fg);
}
.hero__img--1 {
  transform: rotate(-3deg);
}
.hero__img--2 {
  transform: rotate(2.5deg) translateY(-24px);
}
.hero__badge {
  position: absolute;
  left: 50%;
  top: -36px;
  transform: translateX(-50%);
  width: 120px;
  height: 120px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--fg);
  color: var(--bg);
}
.hero__badge svg {
  position: absolute;
  inset: 0;
}
.hero__badge-num {
  font-family: var(--f-display);
  font-weight: var(--d-weight);
  font-stretch: var(--d-stretch);
  font-size: 22px;
}
.hero--split {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr));
  border-bottom: 2px solid var(--fg);
}
.hero--split .hero__title {
  font-size: clamp(52px, 7vw, 112px);
}
.hero--split .hero__title em {
  transform: none;
}
.hero--split .hero__body {
  max-width: 440px;
}
.hero__split-text {
  padding: calc(var(--hero-pt) * 0.6px) clamp(16px, 4vw, 64px) calc(var(--hero-pb) * 0.6px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 28px;
  min-width: 0;
}
.hero__split-media {
  border-left: 2px solid var(--fg);
}
.hero__split-media .media {
  height: 100%;
  min-height: 620px;
  border: 0;
  border-radius: 0;
}
@media (min-width: 750px) {
  .hero__split-text {
    padding-top: calc(var(--hero-pt) * 1px);
    padding-bottom: calc(var(--hero-pb) * 1px);
  }
}
@media (max-width: 767px) {
  .hero__split-media {
    border-left: 0;
    border-top: 2px solid var(--fg);
  }
  .hero__split-media .media {
    min-height: 420px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Layout",
      "options": [
        { "value": "giant-type", "label": "Giant type" },
        { "value": "split", "label": "Split" }
      ],
      "default": "giant-type"
    },
    { "type": "text", "id": "eyebrow", "label": "Subheading", "default": "SS27 / Drop 04 — Available now" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Use italics to highlight a word.",
      "default": "Wear it <em>loud</em>."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Heavyweight basics and statement pieces, cut boxy and built to last. Made for the street, the studio and everything after.</p>"
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop the drop" },
    { "type": "url", "id": "primary_link", "label": "Primary button link", "info": "Links to all products when empty." },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "View lookbook" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link", "info": "Links to all products when empty." },
    { "type": "header", "content": "Giant type layout" },
    { "type": "image_picker", "id": "image_1", "label": "First image", "info": "4:5 aspect ratio recommended" },
    { "type": "image_picker", "id": "image_2", "label": "Second image", "info": "4:5 aspect ratio recommended" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "NEW DROP • LIMITED RUN" },
    { "type": "text", "id": "badge_number", "label": "Badge number", "default": "04" },
    { "type": "header", "content": "Split layout" },
    { "type": "image_picker", "id": "split_image", "label": "Image", "info": "1200 x 1400px .jpg recommended" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "heading": "Wear it <em>loud</em>."
      }
    }
  ]
}
{% endschema %}
