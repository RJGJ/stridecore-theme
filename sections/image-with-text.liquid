{%- liquid
  assign iwt_loading = 'lazy'
  if section.index == 1
    assign iwt_loading = 'eager'
  endif
  assign iwt_ratio = section.settings.image_ratio
  assign iwt_sizes = '(min-width: 960px) 50vw, 100vw'
  if section.settings.image_width == 'large'
    assign iwt_sizes = '(min-width: 960px) 66vw, 100vw'
  elsif section.settings.image_width == 'small'
    assign iwt_sizes = '(min-width: 960px) 33vw, 100vw'
  endif
  assign iwt_focal = 'object-position:' | append: section.settings.image.presentation.focal_point
-%}

<div
  class="iwt iwt--{{ section.settings.layout }} iwt--w-{{ section.settings.image_width }} color-{{ section.settings.color_scheme }}"
  style="--iwt-pt: {{ section.settings.padding_top }}; --iwt-pb: {{ section.settings.padding_bottom }};"
>
  <div class="container iwt__grid">
    <div class="iwt__media">
      {%- if section.settings.image != blank -%}
        <div class="media" {% if iwt_ratio != 'natural' %}style="aspect-ratio: {{ iwt_ratio }}"{% endif %}>
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: loading: iwt_loading, sizes: iwt_sizes, widths: '400,600,800,1000,1200,1600', style: iwt_focal
          }}
        </div>
      {%- else -%}
        <div class="media media--placeholder iwt__placeholder" style="aspect-ratio: {% if iwt_ratio == 'natural' %}4 / 5{% else %}{{ iwt_ratio }}{% endif %}">
          {{ 'image' | placeholder_svg_tag: 'iwt__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <div class="iwt__content iwt__content--{{ section.settings.text_alignment }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'caption' -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.caption }}</p>
          {%- when 'heading' -%}
            <h2 class="display iwt__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}
            <div class="iwt__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.button_label != blank -%}
              {%- assign iwt_url = block.settings.button_link -%}
              <div class="iwt__button" {{ block.shopify_attributes }}>
                <a
                  {% if iwt_url != blank %}href="{{ iwt_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  class="btn {% if block.settings.button_style == 'outline' %}btn--outline{% else %}btn--accent{% endif %}"
                >{{ block.settings.button_label }}</a>
              </div>
            {%- endif -%}
          {%- when '@app' -%}
            <div class="iwt__app" {{ block.shopify_attributes }}>{%- render block -%}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.iwt {
  padding-top: calc(var(--iwt-pt) * 0.6px);
  padding-bottom: calc(var(--iwt-pb) * 0.6px);
}
.iwt__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 32px;
  align-items: center;
}
.iwt__media .media {
  border: 2px solid var(--fg);
}
.iwt__placeholder {
  color: var(--muted);
}
.iwt__placeholder-svg {
  width: 100%;
  height: 100%;
  fill: currentColor;
}
.iwt__content {
  display: flex;
  flex-direction: column;
  gap: 20px;
  min-width: 0;
}
.iwt__content--center {
  align-items: center;
  text-align: center;
}
.iwt__content--right {
  align-items: flex-end;
  text-align: right;
}
.iwt__content--left {
  align-items: flex-start;
}
.iwt__heading {
  font-size: clamp(36px, 4.6vw, 72px);
}
.iwt__heading em {
  display: inline-block;
  padding: 0 0.12em;
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--r);
  font-style: normal;
}
.iwt__text {
  max-width: 520px;
  font-size: 18px;
  line-height: 1.5;
  color: var(--muted);
}
@media (min-width: 750px) {
  .iwt {
    padding-top: calc(var(--iwt-pt) * 1px);
    padding-bottom: calc(var(--iwt-pb) * 1px);
  }
  .iwt__grid {
    gap: clamp(32px, 5vw, 80px);
  }
}
@media (min-width: 960px) {
  .iwt--w-small .iwt__grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
  }
  .iwt--w-medium .iwt__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .iwt--w-large .iwt__grid {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  }
  .iwt--image-right.iwt--w-small .iwt__grid {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  }
  .iwt--image-right.iwt--w-large .iwt__grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
  }
  .iwt--image-right .iwt__media {
    order: 2;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "1200 x 1500px .jpg recommended" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "natural", "label": "Use image ratio" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 2", "label": "Landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image-left", "label": "Left" },
        { "value": "image-right", "label": "Right" }
      ],
      "default": "image-left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "caption",
      "name": "Subheading",
      "settings": [
        { "type": "text", "id": "caption", "label": "Subheading", "default": "Our story" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Made to be <em>worn hard</em>" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text",
          "default": "<p>Pair a short story with an image to explain a product, a process or a brand moment. Keep it to a few clear sentences.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "accent", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "accent"
        }
      ]
    },
    { "type": "@app" }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "caption" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
