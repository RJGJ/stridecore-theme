{%- liquid
  assign limit = section.settings.limit
  assign limit_plus = limit | plus: 1
  assign source = collection
  if source == blank
    assign source = product.collections.first
  endif
  assign shown = 0
  assign has_items = false
  if recommendations.performed and recommendations.products_count > 0
    assign has_items = true
  elsif source != blank and source.products_count > 1
    assign has_items = true
  endif
  assign recs_url = routes.product_recommendations_url
-%}

<section class="related container" aria-labelledby="related-{{ section.id }}"{% unless has_items %} hidden{% endunless %}>
  {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <div class="related__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="display display--md" id="related-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <product-recommendations
    data-url="{{ recs_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit={{ limit }}&amp;intent=related"
    data-loaded="{% if recommendations.performed %}true{% else %}false{% endif %}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="product-grid">
        {%- for item in recommendations.products limit: limit -%}
          {% render 'product-card', product: item, show_quick_add: section.settings.show_quick_add %}
        {%- endfor -%}
      </div>
    {%- elsif recommendations.performed == false and source != blank -%}
      {%- capture fallback -%}
        {%- for item in source.products limit: limit_plus -%}
          {%- if item.id != product.id and shown < limit -%}
            {%- assign shown = shown | plus: 1 -%}
            {% render 'product-card', product: item, show_quick_add: section.settings.show_quick_add %}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if shown > 0 -%}
        <div class="product-grid">{{ fallback }}</div>
      {%- endif -%}
    {%- endif -%}
  </product-recommendations>
</section>

<script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>

{% stylesheet %}
  .related {
    padding-block: clamp(56px, 7vw, 96px) clamp(72px, 9vw, 128px);
  }
  .related__head {
    margin-bottom: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .related product-recommendations {
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Pairs well with" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "Number of products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add", "default": true }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
