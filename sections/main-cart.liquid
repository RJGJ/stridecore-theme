{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign shipping_pct = 100
  assign shipping_unlocked = false
  if threshold > 0
    assign shipping_pct = cart.total_price | times: 100.0 | divided_by: threshold | round | at_most: 100
    if cart.total_price >= threshold
      assign shipping_unlocked = true
    else
      assign remaining_cents = threshold | minus: cart.total_price
      assign remaining_money = remaining_cents | money
    endif
  endif
  assign shop_all_url = section.settings.empty_button_link
  if shop_all_url == blank
    assign shop_all_url = routes.all_products_collection_url
  endif
  assign payment_types = shop.enabled_payment_types
-%}

<cart-page
  class="cart-page"
  data-section-id="{{ section.id }}"
  data-msg-updated="{{ 'cart_page.announce_updated' | t | escape }}"
  data-msg-removed="{{ 'cart_page.announce_removed' | t | escape }}"
  data-msg-error="{{ 'cart_page.announce_error' | t | escape }}"
>
  <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-cart-live></div>

  <div data-cart-root>
    {%- if cart.item_count > 0 -%}
      <section class="cart-page__filled container" aria-labelledby="cart-title-{{ section.id }}">
        <div class="cart-page__top">
          <h1 id="cart-title-{{ section.id }}" class="display cart-page__title" tabindex="-1">
            {{ 'cart.title' | t }}<sup class="cart-page__count" aria-label="{{ 'cart_page.items_count' | t: count: cart.item_count }}">{{ cart.item_count }}</sup>
          </h1>
          <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue">&larr; {{ 'cart_page.continue_shopping' | t }}</a>
        </div>

        {%- if threshold > 0 -%}
          <div class="cart-page__meter" data-shipping-meter>
            <p class="cart-page__meter-msg">
              {%- if shipping_unlocked -%}
                {{ 'cart_page.shipping_unlocked' | t }}
              {%- else -%}
                {{ 'cart_page.shipping_away' | t: amount: remaining_money }}
              {%- endif -%}
            </p>
            <div class="cart-page__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ shipping_pct }}" aria-label="{{ 'cart_page.shipping_progress' | t }}">
              <div class="cart-page__bar-fill" data-bar-fill data-pct="{{ shipping_pct }}" style="width: {{ shipping_pct }}%"></div>
            </div>
          </div>
        {%- endif -%}

        <form action="{{ routes.cart_url }}" method="post" id="cart-form-{{ section.id }}" class="cart-page__layout" novalidate>
          <ul class="cart-page__items" role="list">
            {%- for item in cart.items -%}
              <li class="cart-line" data-line-key="{{ item.key }}" data-line="{{ forloop.index }}">
                <a href="{{ item.url }}" class="cart-line__image" aria-label="{{ item.product.title | escape }}">
                  {% render 'placeholder-media',
                    image: item.image,
                    ratio: '4 / 5',
                    label: 'Image',
                    sizes: '120px',
                    widths: '120,240,360'
                  %}
                </a>
                <div class="cart-line__body">
                  <div class="cart-line__head">
                    <div class="cart-line__meta">
                      <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                      {%- unless item.product.has_only_default_variant -%}
                        <span class="cart-line__variant">
                          {%- for option in item.options_with_values -%}
                            {{ option.value }}{% unless forloop.last %} / {% endunless %}
                          {%- endfor -%}
                        </span>
                      {%- endunless -%}
                      {%- if item.selling_plan_allocation != blank -%}
                        <span class="cart-line__variant">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                      {%- endif -%}
                      {%- assign property_size = item.properties | size -%}
                      {%- if property_size > 0 -%}
                        <ul class="cart-line__props" role="list">
                          {%- for property in item.properties -%}
                            {%- assign first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and first_char != '_' -%}
                              <li>{{ property.first }}: {{ property.last }}</li>
                            {%- endif -%}
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                      {%- assign unit_money = item.final_price | money -%}
                      <span class="cart-line__unit">{{ 'cart_page.each' | t: price: unit_money }}</span>
                      {%- for allocation in item.line_level_discount_allocations -%}
                        <span class="cart-line__discount">{{ allocation.discount_application.title }} (-{{ allocation.amount | money }})</span>
                      {%- endfor -%}
                    </div>
                    <span class="cart-line__price">
                      {%- if item.original_line_price > item.final_line_price -%}
                        <s>{{ item.original_line_price | money }}</s>
                      {%- endif -%}
                      {{ item.final_line_price | money }}
                    </span>
                  </div>

                  <div class="cart-line__actions">
                    <div class="cart-qty">
                      <button type="button" class="cart-qty__btn" data-qty-step="-1" aria-label="{{ 'cart_page.decrease' | t: title: item.product.title }}">&minus;</button>
                      <input
                        type="number"
                        class="cart-qty__input"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        inputmode="numeric"
                        data-qty
                        aria-label="{{ 'cart_page.quantity' | t: title: item.product.title }}"
                      >
                      <button type="button" class="cart-qty__btn" data-qty-step="1" aria-label="{{ 'cart_page.increase' | t: title: item.product.title }}">+</button>
                    </div>
                    <a href="{{ item.url_to_remove }}" class="cart-line__remove" data-remove aria-label="{{ 'cart_page.remove_item' | t: title: item.product.title }}">{{ 'cart_page.remove' | t }}</a>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>

          <aside class="cart-summary" aria-label="{{ 'cart_page.summary' | t }}">
            <h2 class="display cart-summary__title">{{ 'cart_page.summary' | t }}</h2>

            <div class="cart-summary__row">
              <span>{{ 'cart_page.subtotal' | t }}</span>
              <span class="cart-summary__money">{{ cart.original_total_price | money }}</span>
            </div>
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-summary__row cart-summary__row--muted">
                <span>{{ discount.title }}</span>
                <span>-{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
            <div class="cart-summary__row cart-summary__row--muted">
              <span>{{ 'cart_page.shipping' | t }}</span>
              <span>
                {%- if shipping_unlocked -%}
                  {{ 'cart_page.shipping_free' | t }}
                {%- else -%}
                  {{ 'cart_page.at_checkout' | t }}
                {%- endif -%}
              </span>
            </div>
            <div class="cart-summary__row cart-summary__row--muted">
              <span>{{ 'cart_page.taxes' | t }}</span>
              <span>{{ 'cart_page.at_checkout' | t }}</span>
            </div>

            {%- if section.settings.show_order_note -%}
              <div class="field cart-summary__note">
                <label for="cart-note-{{ section.id }}">{{ 'cart_page.order_note' | t }}</label>
                <textarea id="cart-note-{{ section.id }}" name="note" class="input" rows="3" placeholder="{{ 'cart_page.order_note_placeholder' | t }}">{{ cart.note }}</textarea>
              </div>
            {%- endif -%}

            <div class="cart-summary__total">
              <span>{{ 'cart_page.total' | t }}</span>
              <span class="cart-summary__total-money">{{ cart.total_price | money }}</span>
            </div>

            <button type="submit" name="checkout" class="btn btn--accent btn--block cart-summary__checkout">
              <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="5" y="11" width="14" height="10" rx="1"></rect><path d="M8 11V8a4 4 0 018 0v3"></path></svg>
              {{ 'cart_page.checkout' | t }}
            </button>
            <button type="submit" name="update" class="btn btn--outline btn--block btn--sm cart-summary__update">{{ 'cart_page.update' | t }}</button>

            {%- if settings.show_payment_icons and payment_types.size > 0 -%}
              <ul class="cart-summary__payments" role="list">
                {%- for type in payment_types -%}
                  <li>{{ type | payment_type_svg_tag: class: 'cart-summary__payment' }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </aside>
        </form>
      </section>
    {%- else -%}
      <section class="cart-page__empty container" aria-labelledby="cart-title-{{ section.id }}">
        <h1 id="cart-title-{{ section.id }}" class="display cart-page__empty-title" tabindex="-1">
          <span class="visually-hidden">{{ 'cart.empty' | t }}.</span>
          <span aria-hidden="true">{{ 'cart_page.empty_heading_html' | t }}</span>
        </h1>
        {%- if section.settings.empty_text != blank -%}
          <p class="cart-page__empty-text">{{ section.settings.empty_text }}</p>
        {%- endif -%}
        <div class="cart-page__empty-actions">
          <a href="{{ shop_all_url }}" class="btn btn--accent">{{ section.settings.empty_button_label | default: 'Shop the drop' }}</a>
          {%- if customer == nil -%}
            <a href="{{ routes.account_login_url }}" class="btn">{{ 'cart_page.sign_in' | t }}</a>
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}
  </div>

</cart-page>

<script src="{{ 'main-cart.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  cart-page {
    display: block;
  }

  .cart-page__filled {
    padding-block: clamp(32px, 5vw, 64px) clamp(56px, 7vw, 96px);
  }

  .cart-page__top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
  }

  .cart-page__title {
    font-size: clamp(56px, 8vw, 128px);
  }

  .cart-page__count {
    margin-left: 0.2em;
    padding: 0.2em 0.45em;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--f-mono);
    font-size: 0.18em;
    font-weight: 700;
    letter-spacing: 0;
    vertical-align: top;
  }

  .cart-page__continue {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    font-weight: 700;
  }

  .cart-page__meter {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 40px;
    padding: 20px 24px;
    border: 2px solid var(--fg);
    border-radius: var(--r-img);
  }

  .cart-page__meter-msg {
    font-size: 16px;
    font-weight: 700;
  }

  .cart-page__bar {
    height: 14px;
    overflow: hidden;
    border: 2px solid var(--fg);
    border-radius: var(--r-pill);
    background: var(--surface);
  }

  .cart-page__bar-fill {
    height: 100%;
    border-right: 2px solid var(--fg);
    background: var(--accent);
    transition: width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .cart-page__layout {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: clamp(32px, 4vw, 56px);
  }

  .cart-page__items {
    flex: 999 1 560px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--fg);
    list-style: none;
  }

  .cart-line {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .cart-line__image {
    flex: none;
    width: 120px;
    text-decoration: none;
  }

  .cart-line__body {
    display: flex;
    flex: 1 1 240px;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-width: 0;
  }

  .cart-line__head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 16px;
  }

  .cart-line__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .cart-line__title {
    font-size: 18px;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
  }

  .cart-line__variant,
  .cart-line__props {
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 14px;
    list-style: none;
  }

  .cart-line__unit {
    color: var(--muted);
    font-family: var(--f-mono);
    font-size: 14px;
  }

  .cart-line__discount {
    font-size: 13px;
    color: var(--accent-ink);
  }

  .cart-line__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--f-mono);
    font-size: 18px;
    font-weight: 700;
    white-space: nowrap;
  }

  .cart-line__price s {
    color: var(--muted);
    font-size: 13px;
    font-weight: 400;
  }

  .cart-line__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .cart-qty {
    display: flex;
    align-items: center;
    border: 2px solid var(--fg);
    border-radius: var(--r);
  }

  .cart-qty__btn {
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    color: inherit;
    font-size: 20px;
  }

  .cart-qty__input {
    width: 48px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: var(--f-mono);
    font-weight: 700;
    text-align: center;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .cart-qty__input::-webkit-outer-spin-button,
  .cart-qty__input::-webkit-inner-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .cart-line__remove {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: underline;
  }

  .cart-line[aria-busy='true'],
  [data-cart-root][aria-busy='true'] {
    opacity: 0.6;
    pointer-events: none;
  }

  .cart-summary {
    display: flex;
    flex: 1 1 340px;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    padding: 28px;
    border: 2px solid var(--fg);
    border-radius: var(--r-img);
    background: var(--surface);
  }

  .cart-summary__title {
    font-size: 32px;
    line-height: 1;
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 16px;
  }

  .cart-summary__row--muted {
    color: var(--muted);
    font-size: 15px;
  }

  .cart-summary__money {
    font-family: var(--f-mono);
    font-weight: 700;
  }

  .cart-summary__note label {
    font-family: var(--f-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
  }

  .cart-summary__note .input {
    min-height: 0;
    padding: 12px;
    font-size: 15px;
    resize: vertical;
  }

  .cart-summary__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-top: 18px;
    border-top: 2px solid var(--fg);
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .cart-summary__total-money {
    font-family: var(--f-mono);
    font-size: 26px;
    font-weight: 700;
  }

  .cart-summary__checkout {
    min-height: 60px;
    font-size: 16px;
    font-weight: 900;
  }

  /* Plain-form fallback: the update button only shows when JS has not enhanced the cart */
  cart-page[data-js] .cart-summary__update {
    display: none;
  }

  cart-page:not([data-js]) .cart-qty__btn {
    display: none;
  }

  .cart-summary__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-summary__payment {
    width: 38px;
    height: 24px;
  }

  .cart-page__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding-block: clamp(64px, 9vw, 140px);
    text-align: center;
  }

  .cart-page__empty-title {
    font-size: clamp(56px, 9vw, 144px);
  }

  .cart-page__empty-title .highlight {
    transform: rotate(-2deg);
  }

  .cart-page__empty-text {
    max-width: 440px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.5;
  }

  .cart-page__empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-page__bar-fill {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "Show order note field",
      "default": true
    },
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Message",
      "default": "Nothing in here yet. The new drop is a good place to start."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Button label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "empty_button_link",
      "label": "Button link",
      "info": "Leave blank to link to all products."
    }
  ]
}
{% endschema %}
