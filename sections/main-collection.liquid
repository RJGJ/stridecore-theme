{%- liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign has_filters = false
  if collection.filters.size > 0
    assign has_filters = true
  endif

  assign has_active = false
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign has_active = true
      endif
    elsif filter.active_values.size > 0
      assign has_active = true
    endif
  endfor

  assign clear_url = collection.url
  if collection.sort_by != blank and collection.sort_by != collection.default_sort_by
    assign clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
  endif

  case section.settings.card_size
    when 'large'
      assign card_min = '340px'
    when 'small'
      assign card_min = '220px'
    else
      assign card_min = '280px'
  endcase

  case section.settings.image_ratio
    when 'square'
      assign card_ratio = '1 / 1'
    when 'landscape'
      assign card_ratio = '4 / 3'
    else
      assign card_ratio = '4 / 5'
  endcase

  assign promo_block = section.blocks | where: 'type', 'promo' | first
  assign filters_visible = section.settings.filters_open
  if has_filters == false
    assign filters_visible = false
  endif
-%}

<script src="{{ 'facets.js' | asset_url }}" defer></script>

<div class="coll color-{{ section.settings.color_scheme }}" style="--card-min: {{ card_min }}">
  {%- paginate collection.products by section.settings.per_page -%}
    <section class="coll-banner">
      <div class="container coll-banner__inner">
        <nav aria-label="{{ 'collection.breadcrumb' | t }}" class="coll-crumbs">
          <a href="{{ routes.root_url }}">{{ 'collection.home' | t }}</a>
          <span aria-hidden="true">/</span>
          <span class="coll-crumbs__current">{{ collection.title }}</span>
        </nav>

        <div class="coll-banner__head">
          <h1 class="coll-title">
            {{- collection.title -}}
            <sup data-facet-swap="count-banner">{{ paginate.items }}</sup>
          </h1>
          {%- if section.settings.show_description and collection.description != blank -%}
            <div class="coll-desc rte">{{ collection.description }}</div>
          {%- endif -%}
        </div>

        {%- if section.settings.show_image and collection.image != blank -%}
          <div class="coll-hero">
            {% render 'placeholder-media', image: collection.image, ratio: '21 / 9', label: collection.title, sizes: '(min-width: 1360px) 1360px, 100vw', loading: 'eager' %}
          </div>
        {%- endif -%}

        {%- if section.settings.subnav != blank -%}
          <ul class="coll-subnav">
            {%- for link in section.settings.subnav.links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  class="pill{% if link.active %} is-active{% endif %}"
                  {% if link.active %}
                    aria-current="true"
                  {% endif %}
                >
                  {{- link.title -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </section>

    <facet-form
      data-section-id="{{ section.id }}"
      data-label-show="{{ 'collection.show_filters' | t | escape }}"
      data-label-hide="{{ 'collection.hide_filters' | t | escape }}"
    >
      <form
        id="FacetForm-{{ section.id }}"
        class="coll-form"
        method="get"
        action="{{ collection.url }}"
        data-facet-form
      >
        <div class="coll-toolbar">
          <div class="container coll-toolbar__inner">
            {%- if has_filters -%}
              <button
                type="button"
                class="coll-toggle"
                data-facet-toggle
                aria-expanded="{{ filters_visible }}"
                aria-controls="FacetSidebar-{{ section.id }}"
              >
                {% render 'icon', name: 'menu', size: 18 %}
                <span data-facet-toggle-label>
                  {%- if filters_visible -%}
                    {{- 'collection.hide_filters' | t -}}
                  {%- else -%}
                    {{- 'collection.show_filters' | t -}}
                  {%- endif -%}
                </span>
              </button>
            {%- endif -%}

            <p class="coll-count mono" data-facet-swap="count-toolbar">
              {{- 'collection.products_count' | t: count: paginate.items -}}
            </p>

            <div class="coll-sort">
              <label for="SortBy-{{ section.id }}">{{ 'collection.sort_by' | t }}</label>
              <select id="SortBy-{{ section.id }}" name="sort_by" class="coll-select" data-facet-sort>
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}" {% if option.value == current_sort %}selected{% endif %}>
                    {{- option.name -}}
                  </option>
                {%- endfor -%}
              </select>
            </div>

            <button type="submit" class="btn btn--sm coll-apply" data-facet-apply>
              {{- 'collection.apply' | t -}}
            </button>
          </div>
        </div>

        <div class="container coll-body">
          {%- if has_filters -%}
            <aside
              id="FacetSidebar-{{ section.id }}"
              class="coll-filters"
              aria-label="{{ 'collection.filters' | t }}"
              data-facet-sidebar
              {% unless filters_visible %}
                hidden
              {% endunless %}
            >
              <div class="coll-filters__inner" data-facet-swap="sidebar">
                {% render 'facet-filters', filters: collection.filters, id_prefix: section.id %}

                {%- if has_active -%}
                  <a href="{{ clear_url }}" class="coll-clear" data-facet-link>{{ 'collection.clear_all' | t }}</a>
                {%- endif -%}
              </div>
            </aside>
          {%- endif -%}

          <div class="coll-results">
            <p class="visually-hidden" role="status" aria-live="polite" data-facet-status></p>

            <div data-facet-swap="results" class="coll-results__inner">
              {% render 'facet-chips', filters: collection.filters, clear_url: clear_url %}

              {%- if paginate.items == 0 -%}
                <div class="coll-empty">
                  {%- if has_active -%}
                    <h2 class="display display--md">{{ 'collection.empty_title' | t }}</h2>
                    <p class="muted">{{ 'collection.empty_text' | t }}</p>
                    <a href="{{ clear_url }}" class="btn btn--accent" data-facet-link>{{ 'collection.clear_all' | t }}</a>
                  {%- else -%}
                    <h2 class="display display--md">{{ 'collection.empty_collection_title' | t }}</h2>
                    <p class="muted">{{ 'collection.empty_collection_text' | t }}</p>
                    <a href="{{ routes.all_products_collection_url }}" class="btn btn--accent">{{ 'collection.browse_all' | t }}</a>
                  {%- endif -%}
                </div>
              {%- else -%}
                {%- assign show_promo = false -%}
                {%- if section.settings.show_promo and promo_block != blank and paginate.current_page == 1 and has_active == false -%}
                  {%- assign show_promo = true -%}
                {%- endif -%}

                {%- capture promo_html -%}
                  {%- if show_promo -%}
                    {%- assign promo_tone = promo_block.settings.tone | default: 'fg' -%}
                    {%- capture promo_inner -%}
                      {%- if promo_block.settings.eyebrow != blank -%}
                        <span class="coll-promo__eyebrow">{{ promo_block.settings.eyebrow }}</span>
                      {%- endif -%}
                      <span class="coll-promo__heading">{{ promo_block.settings.heading }}</span>
                      {%- if promo_block.settings.text != blank -%}
                        <span class="coll-promo__text">{{ promo_block.settings.text }}</span>
                      {%- endif -%}
                      {%- if promo_block.settings.button_label != blank -%}
                        <span class="coll-promo__btn">{{ promo_block.settings.button_label }}&nbsp;&rarr;</span>
                      {%- endif -%}
                    {%- endcapture -%}
                    {%- if promo_block.settings.link != blank -%}
                      <a href="{{ promo_block.settings.link }}" class="coll-promo coll-promo--{{ promo_tone }}" {{ promo_block.shopify_attributes }}>{{ promo_inner }}</a>
                    {%- else -%}
                      <div class="coll-promo coll-promo--{{ promo_tone }}" {{ promo_block.shopify_attributes }}>{{ promo_inner }}</div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endcapture -%}

                <div class="product-grid coll-grid">
                  {%- for product in collection.products -%}
                    {%- assign card_loading = 'lazy' -%}
                    {%- if forloop.index <= 4 and paginate.current_page == 1 -%}
                      {%- assign card_loading = 'eager' -%}
                    {%- endif -%}
                    {% render 'product-card',
                      product: product,
                      ratio: card_ratio,
                      loading: card_loading,
                      show_vendor: section.settings.show_vendor,
                      sizes: '(min-width: 1024px) 28vw, (min-width: 640px) 45vw, 100vw'
                    %}
                    {%- if show_promo and forloop.index == section.settings.promo_position -%}
                      {{- promo_html -}}
                    {%- endif -%}
                    {%- if show_promo and forloop.last and forloop.index < section.settings.promo_position -%}
                      {{- promo_html -}}
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
            </div>
          </div>
        </div>
      </form>
    </facet-form>
  {%- endpaginate -%}

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div class="container coll-blocks">{% render block %}</div>
      {%- when 'custom_liquid' -%}
        <div class="container coll-blocks" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
    {%- endcase -%}
  {%- endfor -%}
</div>

<noscript>
  <style>
    .coll-filters[hidden] { display: block !important; }
    .coll-toggle { display: none; }
  </style>
</noscript>

{% stylesheet %}
  facet-form { display: block; }
  .coll-banner { border-bottom: 2px solid var(--fg); }
  .coll-banner__inner { display: flex; flex-direction: column; gap: 28px; padding-top: 24px; padding-bottom: clamp(40px, 5vw, 64px); }
  .coll-crumbs { display: flex; flex-wrap: wrap; gap: 10px; font-family: var(--f-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .coll-crumbs a { text-decoration: none; display: inline-flex; align-items: center; min-height: 24px; }
  .coll-crumbs__current { color: var(--fg); }
  .coll-banner__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 24px; }
  .coll-title { overflow-wrap: anywhere; font-family: var(--f-display); font-weight: var(--d-weight); font-stretch: var(--d-stretch); font-size: clamp(64px, 11vw, 176px); line-height: var(--d-lead); letter-spacing: var(--d-track); text-transform: var(--h-case); }
  .coll-title sup { font-family: var(--f-mono); font-size: 0.16em; font-weight: 700; letter-spacing: 0; vertical-align: top; margin-left: 0.2em; padding: 0.2em 0.45em; background: var(--accent); color: var(--on-accent); border-radius: var(--r-pill); }
  .coll-desc { max-width: 420px; font-size: 17px; line-height: 1.55; color: var(--muted); }
  .coll-hero { overflow: hidden; border: 2px solid var(--fg); border-radius: var(--r-img); }
  .coll-blocks { padding-bottom: clamp(32px, 4vw, 56px); }
  .coll-subnav { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; list-style: none; }

  .coll-toolbar { border-bottom: 1px solid var(--line); }
  .coll-toolbar__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding-top: 14px; padding-bottom: 14px; }
  .coll-toggle { min-height: 44px; display: inline-flex; align-items: center; gap: 10px; padding: 0 18px; background: none; border: 2px solid var(--fg); border-radius: var(--r); font-weight: 800; font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; }
  .coll-count { margin: 0 auto 0 0; font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .coll-sort { display: flex; align-items: center; gap: 12px; }
  .coll-sort label { font-family: var(--f-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .coll-select { min-height: 44px; padding: 0 14px; background: var(--bg); color: var(--fg); border: 2px solid var(--fg); border-radius: var(--r); font-size: 15px; font-weight: 600; max-width: 100%; }

  .coll-body { display: flex; flex-wrap: wrap; gap: 40px; align-items: start; padding-top: 32px; padding-bottom: clamp(64px, 8vw, 112px); }
  .coll-filters { flex: 1 1 240px; max-width: 100%; }
  .coll-filters__inner { display: flex; flex-direction: column; gap: 32px; }
  .coll-clear { align-self: start; display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 700; text-decoration: underline; }

  .coll-results { flex: 999 1 560px; min-width: 0; }
  .coll-results__inner { display: flex; flex-direction: column; gap: 28px; transition: opacity 0.2s; }
  .coll-results__inner.is-loading { opacity: 0.45; pointer-events: none; }
  .coll-grid { grid-template-columns: repeat(auto-fill, minmax(min(var(--card-min, 280px), 100%), 1fr)); gap: 40px 20px; }
  .coll-results__inner .pagination { margin-top: 24px; }

  .coll-promo { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 28px; min-height: 100%; background: var(--fg); color: var(--bg); border: 2px solid var(--fg); border-radius: var(--r-img); text-decoration: none; }
  .coll-promo--accent { background: var(--accent); color: var(--on-accent); }
  .coll-promo--surface { background: var(--surface); color: var(--fg); }
  .coll-promo__eyebrow { font-family: var(--f-mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.1em; }
  .coll-promo__heading { font-family: var(--f-display); font-weight: var(--d-weight); font-stretch: var(--d-stretch); font-size: clamp(34px, 3.4vw, 52px); line-height: var(--d-lead); letter-spacing: var(--d-track); text-transform: var(--h-case); }
  .coll-promo__text { font-size: 16px; line-height: 1.5; opacity: 0.85; }
  .coll-promo__btn { align-self: start; display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; background: var(--accent); color: var(--on-accent); font-weight: 800; font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; border-radius: var(--r); }
  .coll-promo--accent .coll-promo__btn { background: var(--on-accent); color: var(--accent); }
  a.coll-promo { transition: transform 0.15s; }
  a.coll-promo:hover { transform: translate(-3px, -3px); opacity: 1; }

  .coll-empty { display: flex; flex-direction: column; align-items: start; gap: 20px; padding: clamp(24px, 4vw, 56px) 0; }
  .coll-empty p { max-width: 480px; font-size: 17px; line-height: 1.5; }

  @media (prefers-reduced-motion: reduce) {
    .coll-results__inner, a.coll-promo { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection page",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 4, "max": 48, "step": 4, "default": 12 },
    {
      "type": "select",
      "id": "card_size",
      "label": "Card size",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "info": "Images are cropped to fit, using the focal point you set.",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "filters_open", "label": "Show filters on page load", "default": true },
    { "type": "header", "content": "Banner" },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show collection image", "default": true },
    { "type": "link_list", "id": "subnav", "label": "Sub-collection menu", "info": "Shown as buttons under the heading." },
    { "type": "header", "content": "Promo tile" },
    { "type": "checkbox", "id": "show_promo", "label": "Show promo tile", "default": true },
    { "type": "range", "id": "promo_position", "label": "Promo tile position", "min": 1, "max": 12, "step": 1, "default": 5, "info": "Number of products shown before the tile." }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo tile",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bundle deal" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Any 3 tees for a set price" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Build your bundle" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "tone",
          "label": "Tone",
          "options": [
            { "value": "fg", "label": "Dark" },
            { "value": "accent", "label": "Accent" },
            { "value": "surface", "label": "Surface" }
          ],
          "default": "fg"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom liquid",
      "settings": [
        { "type": "liquid", "id": "custom_liquid", "label": "Liquid" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Collection page",
      "blocks": [{ "type": "promo" }]
    }
  ]
}
{% endschema %}
