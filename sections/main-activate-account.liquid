<section class="pwf container">
  <div class="pwf__panel">
    <h1 class="display pwf__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="pwf__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'activate_customer_password', class: 'pwf__form', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert">
          <p class="pwf__error-title">{{ 'account.error_title' | t }}</p>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="field">
        <label for="ActivatePassword">{{ 'customers.activate.password' | t }}</label>
        <input id="ActivatePassword" class="input" type="password" name="customer[password]" autocomplete="new-password" required aria-required="true"{% if form.errors contains 'password' %} aria-invalid="true"{% endif %}>
      </div>
      <div class="field">
        <label for="ActivatePasswordConfirm">{{ 'customers.activate.confirm' | t }}</label>
        <input id="ActivatePasswordConfirm" class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required aria-required="true"{% if form.errors contains 'password_confirmation' %} aria-invalid="true"{% endif %}>
      </div>
      <button type="submit" class="btn btn--accent btn--block">{{ 'customers.activate.submit' | t }}</button>
      <button type="submit" name="decline" class="btn btn--outline btn--block">{{ 'customers.activate.decline' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .pwf {
    padding-block: clamp(40px, 6vw, 96px);
  }

  .pwf__panel {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 520px;
  }

  .pwf__title {
    margin: 0;
    font-size: clamp(44px, 6vw, 88px);
  }

  .pwf__text {
    margin: 0;
    color: var(--muted);
    font-size: 17px;
  }

  .pwf__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pwf .field label {
    color: var(--fg);
    font-family: var(--f-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }

  .pwf__error-title {
    margin: 0;
    font-weight: 800;
  }

  .pwf .form-message ul {
    margin: 8px 0 0;
    padding-left: 20px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Activate account",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Activate your account." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Create a password to finish setting up your account." }
  ]
}
{% endschema %}
