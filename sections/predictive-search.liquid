{% # theme-check-disable ValidScopedCSSClass %}
{%- comment -%}
  The .ps-* styles live in sections/header.liquid so they are loaded on every page.
  Rendered on demand by the Section Rendering API from assets/predictive-search.js.
  Output is the markup placed inside the dropdown panel ([data-predictive-panel]).
{%- endcomment -%}

{%- if predictive_search.performed -%}
  {%- liquid
    assign res = predictive_search.resources
    assign total = res.products.size | plus: res.collections.size | plus: res.pages.size | plus: res.articles.size | plus: res.queries.size
    assign terms = predictive_search.terms
    assign encoded_terms = terms | url_encode
    assign view_all_url = routes.search_url | append: '?q=' | append: encoded_terms
    assign opt = 0
  -%}
  <div data-predictive-results>
    <p class="visually-hidden" data-predictive-status>
      {%- if total == 0 -%}
        {{- 'search.no_suggestions' | t -}}
      {%- else -%}
        {{- 'search.suggestions_count' | t: count: total -}}
      {%- endif -%}
    </p>

    {%- if total == 0 -%}
      <p class="ps-empty">{{ 'search.no_suggestions_for' | t: terms: terms }}</p>
    {%- endif -%}

    {%- if res.queries.size > 0 -%}
      <div class="ps-group" role="group" aria-label="{{ 'search.suggestions' | t }}">
        <p class="ps-heading" aria-hidden="true">{{ 'search.suggestions' | t }}</p>
        <ul class="ps-list">
          {%- for query in res.queries -%}
            {%- assign opt = opt | plus: 1 -%}
            <li role="presentation">
              <a href="{{ query.url }}" role="option" id="PSOption-{{ opt }}" class="ps-link">
                <span class="ps-link__title">{{ query.styled_text }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if res.products.size > 0 -%}
      <div class="ps-group" role="group" aria-label="{{ 'search.products' | t }}">
        <p class="ps-heading" aria-hidden="true">{{ 'search.products' | t }}</p>
        <ul class="ps-list">
          {%- for product in res.products -%}
            {%- assign opt = opt | plus: 1 -%}
            <li role="presentation">
              <a href="{{ product.url }}" role="option" id="PSOption-{{ opt }}" class="ps-link ps-link--product">
                <span class="ps-thumb" aria-hidden="true">
                  {% render 'placeholder-media', image: product.featured_image, ratio: '1 / 1', label: '', sizes: '64px', widths: '128,192' %}
                </span>
                <span class="ps-link__title">{{ product.title }}</span>
                <span class="ps-link__price mono">{{ product.price | money }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if res.collections.size > 0 -%}
      <div class="ps-group" role="group" aria-label="{{ 'search.collections' | t }}">
        <p class="ps-heading" aria-hidden="true">{{ 'search.collections' | t }}</p>
        <ul class="ps-list">
          {%- for collection in res.collections -%}
            {%- assign opt = opt | plus: 1 -%}
            <li role="presentation">
              <a href="{{ collection.url }}" role="option" id="PSOption-{{ opt }}" class="ps-link">
                <span class="ps-link__title">{{ collection.title }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- assign content_count = res.pages.size | plus: res.articles.size -%}
    {%- if content_count > 0 -%}
      <div class="ps-group" role="group" aria-label="{{ 'search.pages' | t }}">
        <p class="ps-heading" aria-hidden="true">{{ 'search.pages' | t }}</p>
        <ul class="ps-list">
          {%- for page in res.pages -%}
            {%- assign opt = opt | plus: 1 -%}
            <li role="presentation">
              <a href="{{ page.url }}" role="option" id="PSOption-{{ opt }}" class="ps-link">
                <span class="ps-link__title">{{ page.title }}</span>
              </a>
            </li>
          {%- endfor -%}
          {%- for article in res.articles -%}
            {%- assign opt = opt | plus: 1 -%}
            <li role="presentation">
              <a href="{{ article.url }}" role="option" id="PSOption-{{ opt }}" class="ps-link">
                <span class="ps-link__title">{{ article.title }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if total > 0 -%}
      {%- assign opt = opt | plus: 1 -%}
      <a href="{{ view_all_url }}" role="option" id="PSOption-{{ opt }}" class="ps-all">
        {{- 'search.view_all' | t }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Predictive search"
}
{% endschema %}
