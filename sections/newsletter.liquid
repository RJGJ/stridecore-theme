{%- liquid
  assign nl_input_id = 'nl-email-' | append: section.id
  assign nl_placeholder = 'home.newsletter.email_placeholder' | t
-%}

<div
  class="newsletter color-{{ section.settings.color_scheme }}"
  style="--nl-pt: {{ section.settings.padding_top }}; --nl-pb: {{ section.settings.padding_bottom }};"
>
  <div class="container">
  <div class="newsletter__box">
    <h2 class="display display--md newsletter__heading">{{ section.settings.heading }}</h2>
    {%- form 'customer', id: section.id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="{{ nl_input_id }}" class="eyebrow">{{ section.settings.label }}</label>
      <div class="newsletter__row">
        <input
          id="{{ nl_input_id }}"
          class="input newsletter__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ nl_placeholder }}"
          autocomplete="email"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="{{ nl_input_id }}-msg"{% endif %}
        >
        <button type="submit" class="btn btn--ink">{{ section.settings.button_label }}</button>
      </div>
      <div id="{{ nl_input_id }}-msg" role="status" aria-live="polite">
        {%- if form.posted_successfully? -%}
          <p class="form-message">{{ 'home.newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ 'home.newsletter.error' | t }}</p>
        {%- endif -%}
      </div>
    {%- endform -%}
  </div>
  </div>
</div>

{% stylesheet %}
.newsletter {
  padding-top: calc(var(--nl-pt) * 0.6px);
  padding-bottom: calc(var(--nl-pb) * 0.6px);
}
@media (min-width: 750px) {
  .newsletter {
    padding-top: calc(var(--nl-pt) * 1px);
    padding-bottom: calc(var(--nl-pb) * 1px);
  }
}
.newsletter__box {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
  gap: 40px;
  align-items: end;
  padding: clamp(32px, 5vw, 72px);
  background: var(--surface);
  border-radius: var(--r-img);
}
.newsletter__heading em {
  display: inline-block;
  font-style: normal;
  padding: 0 0.1em;
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--r);
}
.newsletter__form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
}
.newsletter__row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.newsletter__input {
  flex: 1 1 240px;
  width: auto;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Use italics to highlight a word.",
      "default": "Get the drop <em>first</em>."
    },
    { "type": "text", "id": "label", "label": "Email field label", "default": "Early access, restocks, no spam" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
