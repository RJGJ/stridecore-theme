{%- liquid
  assign nl_heading = section.settings.heading | strip
  assign nl_words = nl_heading | split: ' '
  assign nl_last = nl_words | last
  assign nl_first = nl_heading | remove_last: nl_last | strip
  assign nl_input_id = 'nl-email-' | append: section.id
  assign nl_placeholder = 'home.newsletter.email_placeholder' | t
-%}

<section class="container newsletter">
  <div class="newsletter__box">
    <h2 class="display display--md">
      {%- if nl_first != blank %}{{ nl_first }} {% endif -%}
      <span class="newsletter__hl">{{ nl_last }}</span>
    </h2>
    {%- form 'customer', id: section.id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="{{ nl_input_id }}" class="eyebrow">{{ section.settings.label }}</label>
      <div class="newsletter__row">
        <input
          id="{{ nl_input_id }}"
          class="input newsletter__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ nl_placeholder }}"
          autocomplete="email"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="{{ nl_input_id }}-msg"{% endif %}
        >
        <button type="submit" class="btn btn--ink">{{ section.settings.button_label }}</button>
      </div>
      <div id="{{ nl_input_id }}-msg" role="status" aria-live="polite">
        {%- if form.posted_successfully? -%}
          <p class="form-message">{{ 'home.newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ 'home.newsletter.error' | t }}</p>
        {%- endif -%}
      </div>
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
.newsletter {
  padding-bottom: clamp(64px, 8vw, 120px);
}
.newsletter__box {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
  gap: 40px;
  align-items: end;
  padding: clamp(32px, 5vw, 72px);
  background: var(--surface);
  border-radius: var(--r-img);
}
.newsletter__hl {
  padding: 0 0.1em;
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--r);
}
.newsletter__form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
}
.newsletter__row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.newsletter__input {
  flex: 1 1 240px;
  width: auto;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "The last word is highlighted.",
      "default": "Get the drop first."
    },
    { "type": "text", "id": "label", "label": "Label", "default": "Early access, restocks, no spam" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
