<section class="acct">
  <div class="acct__main">
    <h1 class="display acct__title">{{ section.settings.heading }}</h1>

    <nav class="acct__tabs" aria-label="{{ 'general.account' | t }}">
      <a href="{{ routes.account_login_url }}" class="acct__tab">{{ 'account.sign_in' | t }}</a>
      <a href="{{ routes.account_register_url }}" class="acct__tab" aria-current="page">{{ 'account.create_account' | t }}</a>
    </nav>

    {%- form 'create_customer', novalidate: 'novalidate', class: 'acct__form acct__form--grid' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error acct__wide" role="alert">
          <p class="acct__error-title">{{ 'account.error_title' | t }}</p>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="field">
        <label for="RegisterFirstName">{{ 'account.first_name' | t }}</label>
        <input id="RegisterFirstName" class="input" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}">
      </div>
      <div class="field">
        <label for="RegisterLastName">{{ 'account.last_name' | t }}</label>
        <input id="RegisterLastName" class="input" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}">
      </div>
      <div class="field acct__wide">
        <label for="RegisterEmail">{{ 'account.email' | t }}</label>
        <input id="RegisterEmail" class="input" type="email" name="customer[email]" autocomplete="email" autocapitalize="off" required aria-required="true" value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
      </div>
      <div class="field acct__wide">
        <label for="RegisterPassword">{{ 'account.password' | t }}</label>
        <input id="RegisterPassword" class="input" type="password" name="customer[password]" autocomplete="new-password" required aria-required="true"{% if form.errors contains 'password' %} aria-invalid="true"{% endif %}>
      </div>
      {%- if section.settings.show_marketing_optin -%}
        <label class="acct__check acct__wide">
          <input id="RegisterMarketing" type="checkbox" name="customer[accepts_marketing]" value="true" checked>
          {{ 'account.marketing_optin' | t }}
        </label>
      {%- endif -%}
      <button type="submit" class="btn btn--accent btn--block acct__submit acct__wide">{{ 'account.create_account' | t }}</button>
    {%- endform -%}

    <p class="acct__muted">
      {{ 'account.have_account' | t }}
      <a href="{{ routes.account_login_url }}" class="acct__link">{{ 'account.sign_in' | t }}</a>
    </p>
  </div>

  <aside class="acct__perks" aria-label="{{ section.settings.perks_label | escape }}">
    <span class="acct__perks-label">{{ section.settings.perks_label }}</span>
    <ol class="acct__perks-list">
      {%- for block in section.blocks -%}
        <li class="acct__perk" {{ block.shopify_attributes }}>
          <span class="acct__perk-n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="display acct__perk-label">{{ block.settings.label }}</span>
        </li>
      {%- endfor -%}
    </ol>
    <span class="acct__perks-note">{{ section.settings.perks_note }}</span>
  </aside>
</section>

{% stylesheet %}
  .acct {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr));
    border-bottom: 2px solid var(--fg);
  }

  .acct__main {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: clamp(40px, 6vw, 96px) clamp(16px, 4vw, 72px);
  }

  .acct__title {
    font-size: clamp(52px, 7vw, 112px);
  }

  .acct__tabs {
    display: flex;
    align-self: start;
    overflow: hidden;
    border: 2px solid var(--fg);
    border-radius: var(--r);
  }

  .acct__tab {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .acct__tab[aria-current='page'] {
    background: var(--fg);
    color: var(--bg);
  }

  .acct__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 480px;
  }

  .acct__form--grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
  }

  .acct__wide {
    grid-column: 1 / -1;
  }

  .acct .field label {
    color: var(--fg);
    font-family: var(--f-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }

  .acct__check {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    cursor: pointer;
    font-size: 15px;
  }

  .acct__check input {
    flex: none;
    width: 20px;
    height: 20px;
    accent-color: var(--fg);
  }

  .acct__submit {
    min-height: 60px;
    font-size: 16px;
    font-weight: 900;
  }

  .acct__error-title {
    font-weight: 800;
  }

  .acct .form-message ul {
    margin: 8px 0 0;
    padding-left: 20px;
  }

  .acct__muted {
    color: var(--muted);
    font-size: 15px;
  }

  .acct__link {
    color: var(--fg);
    font-weight: 700;
  }

  .acct__perks {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    padding: clamp(40px, 6vw, 96px) clamp(16px, 4vw, 72px);
    border-left: 2px solid var(--fg);
    background: var(--accent);
    color: var(--on-accent);
  }

  .acct__perks-label {
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .acct__perks-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .acct__perk {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 22px 0;
    border-top: 2px solid var(--on-accent);
  }

  .acct__perk-n {
    font-family: var(--f-mono);
    font-size: 14px;
    font-weight: 700;
  }

  .acct__perk-label {
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1;
  }

  .acct__perks-note {
    max-width: 380px;
    font-size: 15px;
    line-height: 1.5;
  }

  @media (max-width: 989px) {
    .acct__perks {
      border-left: 0;
      border-top: 2px solid var(--fg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Create account",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the crew." },
    { "type": "checkbox", "id": "show_marketing_optin", "label": "Show email marketing opt-in", "default": true },
    { "type": "header", "content": "Perks panel" },
    { "type": "text", "id": "perks_label", "label": "Label", "default": "Members get" },
    {
      "type": "textarea",
      "id": "perks_note",
      "label": "Note",
      "default": "Track orders, start returns and save your addresses in one place."
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Early access to drops" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
