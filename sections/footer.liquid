<footer class="site-footer">
  <div class="site-footer__cols">
    {%- for block in section.blocks -%}
      <div class="site-footer__col" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <span class="site-footer__heading">{{ block.settings.heading }}</span>
        {%- endif -%}
        {%- if block.settings.menu != blank -%}
          {%- for link in block.settings.menu.links -%}
            <a href="{{ link.url }}" class="site-footer__link">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- liquid
      assign has_social = false
      if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_facebook != blank
        assign has_social = true
      endif
      assign has_store = false
      if settings.store_address != blank or settings.support_email != blank
        assign has_store = true
      endif
    -%}
    {%- if section.settings.show_follow and has_social -%}
      <div class="site-footer__col">
        <span class="site-footer__heading">{{ 'chrome.footer.follow' | t }}</span>
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" class="site-footer__link" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" class="site-footer__link" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" class="site-footer__link" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_store and has_store -%}
      <div class="site-footer__col">
        <span class="site-footer__heading">{{ 'chrome.footer.store' | t }}</span>
        <div class="site-footer__store">
          {%- if settings.store_address != blank -%}{{ settings.store_address | newline_to_br }}{%- endif -%}
          {%- if settings.support_email != blank -%}<br><a href="mailto:{{ settings.support_email }}" class="site-footer__mail">{{ settings.support_email }}</a>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="site-footer__wordmark-wrap">
    <div class="site-footer__wordmark" aria-hidden="true">{{ shop.name }}<span class="site-footer__dot">.</span></div>
  </div>

  {%- assign copyright_year = 'now' | date: '%Y' -%}
  <div class="site-footer__bar">
    <div class="site-footer__bar-inner">
      <span>{{ 'chrome.footer.copyright' | t: year: copyright_year, shop: shop.name }}</span>
      {%- if settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="site-footer__payments" aria-label="{{ 'chrome.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    border-top: 2px solid var(--fg);
  }
  .site-footer__cols {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 56px var(--gutter) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 40px;
  }
  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 15px;
  }
  .site-footer__heading {
    font-family: var(--f-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .site-footer__link {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    width: fit-content;
  }
  .site-footer__store {
    color: var(--muted);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .site-footer__mail {
    text-decoration: none;
  }
  .site-footer__wordmark-wrap {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 48px var(--gutter) 0;
    overflow: hidden;
  }
  .site-footer__wordmark {
    font-family: var(--f-display);
    font-weight: var(--d-weight);
    font-stretch: var(--d-stretch);
    font-size: clamp(56px, 15vw, 240px);
    line-height: 0.85;
    letter-spacing: var(--d-track);
    text-transform: var(--h-case);
    white-space: nowrap;
  }
  .site-footer__dot {
    color: var(--accent-ink);
  }
  .site-footer__bar {
    border-top: 1px solid var(--line);
    margin-top: 24px;
  }
  .site-footer__bar-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 20px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .site-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__payments .icon {
    width: 38px;
    height: 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_follow", "label": "Show Follow column", "info": "Uses the social links in theme settings.", "default": true },
    { "type": "checkbox", "id": "show_store", "label": "Show Store column", "info": "Uses store address and support email from theme settings.", "default": true }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link list",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Shop", "menu": "footer" } },
        { "type": "link_list", "settings": { "heading": "Help" } }
      ]
    }
  ]
}
{% endschema %}
