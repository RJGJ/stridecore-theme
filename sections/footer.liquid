<footer class="site-footer color-{{ section.settings.color_scheme }}">
  <div class="site-footer__cols">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'link_list' -%}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="site-footer__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="site-footer__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
                    {%- if link.links.size > 0 -%}
                      <ul class="site-footer__sublinks" role="list">
                        {%- for child in link.links -%}
                          <li><a href="{{ child.url }}" class="site-footer__link site-footer__link--sub"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

        {%- when 'newsletter' -%}
          {%- liquid
            assign nl_form_id = 'FooterNewsletter-' | append: block.id
            assign nl_input_id = 'FooterEmail-' | append: block.id
          -%}
          <div class="site-footer__col site-footer__col--wide" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="site-footer__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- form 'customer', id: nl_form_id, class: 'site-footer__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label for="{{ nl_input_id }}" class="visually-hidden">{{ 'site.footer.email_label' | t }}</label>
              <div class="site-footer__field">
                <input
                  id="{{ nl_input_id }}"
                  class="input site-footer__input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ 'site.footer.email_placeholder' | t }}"
                  autocomplete="email"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="{{ nl_input_id }}-msg"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="{{ nl_input_id }}-msg"
                  {% endif %}
                >
                <button type="submit" class="btn btn--accent site-footer__submit">{{ block.settings.button_label }}</button>
              </div>
              <div id="{{ nl_input_id }}-msg" role="status" aria-live="polite">
                {%- if form.posted_successfully? -%}
                  <p class="form-message">{{ 'site.footer.signup_success' | t }}</p>
                {%- elsif form.errors -%}
                  <p class="form-message form-message--error" role="alert">{{ 'site.footer.signup_error' | t }}</p>
                {%- endif -%}
              </div>
            {%- endform -%}
          </div>

        {%- when 'social_media' -%}
          {%- assign follow_button = shop | login_button: action: 'follow' -%}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {% render 'social-links', class: 'site-footer__social' %}
            {%- if block.settings.show_follow_on_shop and follow_button != blank -%}
              <div class="site-footer__follow">{{ follow_button }}</div>
            {%- endif -%}
          </div>

        {%- when 'store_info' -%}
          {%- if settings.store_address != blank or settings.support_email != blank -%}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <div class="site-footer__store">
                {%- if settings.store_address != blank -%}{{ settings.store_address | newline_to_br }}{%- endif -%}
                {%- if settings.support_email != blank -%}<br><a href="mailto:{{ settings.support_email }}" class="site-footer__mail">{{ settings.support_email }}</a>{%- endif -%}
              </div>
            </div>
          {%- endif -%}

        {%- when 'text' -%}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte site-footer__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when '@app' -%}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- liquid
    assign has_localization = false
    if localization.available_countries.size > 1 or localization.available_languages.size > 1
      assign has_localization = true
    endif
  -%}
  {%- if has_localization and section.settings.show_localization -%}
    <div class="site-footer__loc">
      {% render 'localization-selector', id: 'footer', direction: 'up' %}
    </div>
  {%- endif -%}

  {%- if section.settings.show_wordmark -%}
    <div class="site-footer__wordmark-wrap">
      <div class="site-footer__wordmark" aria-hidden="true">{{ shop.name }}<span class="site-footer__dot">.</span></div>
    </div>
  {%- endif -%}

  {%- assign copyright_year = 'now' | date: '%Y' -%}
  <div class="site-footer__bar">
    <div class="site-footer__bar-inner">
      <span>{{ 'chrome.footer.copyright' | t: year: copyright_year, shop: shop.name }}</span>
      <span class="site-footer__powered">{{ powered_by_link }}</span>
      {%- if settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="site-footer__payments" role="list" aria-label="{{ 'chrome.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

<script src="{{ 'localization.js' | asset_url }}" defer></script>

{% stylesheet %}
  .site-footer {
    border-top: 2px solid var(--fg);
    background: var(--bg);
    color: var(--fg);
  }
  .site-footer__cols {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 56px var(--gutter) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 40px;
  }
  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 15px;
    min-width: 0;
  }
  .site-footer__col--wide {
    grid-column: span 2;
  }
  .site-footer__heading {
    margin: 0;
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .site-footer__links,
  .site-footer__sublinks {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__sublinks {
    padding-left: 14px;
  }
  .site-footer__link {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    width: fit-content;
  }
  .site-footer__link--sub {
    color: var(--muted);
    font-size: 14px;
  }
  .site-footer__link[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .site-footer__text {
    margin: 0;
    max-width: 420px;
    color: var(--muted);
    line-height: 1.5;
  }
  .site-footer__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 460px;
  }
  .site-footer__field {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .site-footer__input {
    flex: 1 1 200px;
    min-width: 0;
  }
  .site-footer__submit {
    flex: none;
  }
  .site-footer__follow {
    display: flex;
    min-height: 44px;
    align-items: center;
  }
  .site-footer__store {
    color: var(--muted);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .site-footer__mail {
    text-decoration: none;
  }
  .site-footer__loc {
    max-width: var(--page-max);
    margin: 32px auto 0;
    padding: 0 var(--gutter);
  }
  .site-footer__wordmark-wrap {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 48px var(--gutter) 0;
    overflow: hidden;
  }
  .site-footer__wordmark {
    font-family: var(--f-display);
    font-weight: var(--d-weight);
    font-stretch: var(--d-stretch);
    font-size: clamp(56px, 15vw, 240px);
    line-height: 0.85;
    letter-spacing: var(--d-track);
    text-transform: var(--h-case);
    white-space: nowrap;
  }
  .site-footer__dot {
    color: var(--accent-ink);
  }
  .site-footer__bar {
    border-top: 1px solid var(--line);
    margin-top: 24px;
  }
  .site-footer__bar-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 20px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .site-footer__powered a {
    color: inherit;
  }
  .site-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__payments .icon {
    width: 38px;
    height: 24px;
  }
  @media (max-width: 599px) {
    .site-footer__col--wide {
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_localization", "label": "Show country and language selectors", "info": "Appears when the store sells in more than one country or language.", "default": true },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show large store name", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Footer menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Email signup",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the crew" },
        { "type": "text", "id": "text", "label": "Text", "default": "Be first to hear about new drops and restocks." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" }
      ]
    },
    {
      "type": "social_media",
      "name": "Social media",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Add your social media links under the social media section of the theme settings." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow" },
        { "type": "checkbox", "id": "show_follow_on_shop", "label": "Show button to follow on Shop", "info": "Appears when Shop Pay is enabled for the store.", "default": true }
      ]
    },
    {
      "type": "store_info",
      "name": "Store details",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Uses the store address and support email from the theme settings." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Store" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Performance apparel built for movement, made to last.</p>" }
      ]
    },
    { "type": "@app" }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Shop", "menu": "footer" } },
        { "type": "newsletter" },
        { "type": "social_media" },
        { "type": "store_info" }
      ]
    }
  ]
}
{% endschema %}
