<div
  class="perks color-{{ section.settings.color_scheme }}"
  style="--perks-pt: {{ section.settings.padding_top }}; --perks-pb: {{ section.settings.padding_bottom }};"
>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="display display--md perks__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="perks__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign perk_number = forloop.index | plus: 100 | append: '' | slice: 1, 2
      -%}
      {%- if block.type == '@app' -%}
        <div class="perks__item" {{ block.shopify_attributes }}>
          {%- render block -%}
        </div>
      {%- else -%}
        <div class="perks__item" {{ block.shopify_attributes }}>
          <span class="perks__num" aria-hidden="true">{{ perk_number }}</span>
          <h3 class="perks__title">{{ block.settings.title }}</h3>
          <div class="perks__text rte">{{ block.settings.text }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.perks {
  padding-top: calc(var(--perks-pt) * 0.6px);
  padding-bottom: calc(var(--perks-pb) * 0.6px);
}
@media (min-width: 750px) {
  .perks {
    padding-top: calc(var(--perks-pt) * 1px);
    padding-bottom: calc(var(--perks-pb) * 1px);
  }
}
.perks__heading {
  margin-bottom: 32px;
}
.perks__heading em {
  display: inline-block;
  padding: 0 0.12em;
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--r);
  font-style: normal;
}
.perks__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
  border: 2px solid var(--fg);
  border-radius: var(--r-img);
  overflow: hidden;
}
.perks__item {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 32px 28px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.perks__num {
  font-family: var(--f-mono);
  font-size: 13px;
  font-weight: 700;
  color: var(--accent-ink);
}
.perks__title {
  font-family: var(--f-body);
  font-size: 20px;
  font-weight: 800;
  text-transform: uppercase;
}
.perks__text {
  font-size: 15px;
  line-height: 1.5;
  color: var(--muted);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Perks",
  "tag": "section",
  "class": "section-perks",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Heavyweight" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text",
          "default": "<p>Dense cotton that holds its shape wash after wash.</p>"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Perks",
      "blocks": [
        { "type": "perk", "settings": { "title": "Heavyweight", "text": "<p>Dense cotton that holds its shape wash after wash.</p>" } },
        { "type": "perk", "settings": { "title": "Boxy fits", "text": "<p>Dropped shoulders, cropped lengths. Size guide on every product.</p>" } },
        { "type": "perk", "settings": { "title": "Easy returns", "text": "<p>Changed your mind? Send it back, no questions asked.</p>" } },
        { "type": "perk", "settings": { "title": "Limited runs", "text": "<p>Small batches. When a drop is gone, it is gone.</p>" } }
      ]
    }
  ]
}
{% endschema %}
