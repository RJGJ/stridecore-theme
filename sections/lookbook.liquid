{%- liquid
  assign lookbook_url = section.settings.button_link
  if lookbook_url == blank
    assign lookbook_url = routes.all_products_collection_url
  endif
  assign label_image = 'home.lookbook.image_label' | t
-%}

<section class="lookbook lookbook--{{ section.settings.image_side }}">
  <div class="lookbook__media">
    {% render 'placeholder-media',
      image: section.settings.image,
      label: label_image,
      tone: 'surface',
      sizes: '(min-width: 960px) 50vw, 100vw'
    %}
  </div>
  <div class="lookbook__panel">
    {%- if section.settings.eyebrow != blank -%}
      <span class="lookbook__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <div class="lookbook__copy">
      <h2 class="display display--lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lookbook__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ lookbook_url }}" class="btn btn--invert lookbook__btn">{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 18, stroke: 2.5 %}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.lookbook {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr));
}
.lookbook__media .media {
  height: 100%;
  min-height: 640px;
  border: 0;
  border-radius: 0;
}
.lookbook__panel {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 48px;
  min-width: 0;
  padding: clamp(40px, 6vw, 96px) clamp(16px, 4vw, 72px);
  background: var(--accent);
  color: var(--on-accent);
}
.lookbook__eyebrow {
  font-family: var(--f-mono);
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.lookbook__copy {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.lookbook__copy .display {
  font-size: clamp(44px, 5.5vw, 88px);
}
.lookbook__text {
  max-width: 460px;
  font-size: 19px;
  line-height: 1.5;
}
.lookbook__btn {
  align-self: start;
}
@media (min-width: 960px) {
  .lookbook--right .lookbook__media {
    order: 2;
  }
}
@media (max-width: 767px) {
  .lookbook__media .media {
    min-height: 420px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section-lookbook",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lookbook — Vol. 04" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the after-hours." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Shot after dark across the city. See how the new drop moves, then shop every look straight from the page."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the lookbook" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Lookbook" }]
}
{% endschema %}
