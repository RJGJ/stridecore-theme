{%- liquid
  assign lookbook_url = section.settings.button_link
  if lookbook_url == blank
    assign lookbook_url = routes.all_products_collection_url
  endif
  assign label_image = 'home.lookbook.image_label' | t
-%}

<div
  class="lookbook lookbook--{{ section.settings.image_side }} color-{{ section.settings.color_scheme }}"
  style="--lookbook-pt: {{ section.settings.padding_top }}; --lookbook-pb: {{ section.settings.padding_bottom }};"
>
  <div class="lookbook__media">
    {% render 'placeholder-media',
      image: section.settings.image,
      label: label_image,
      tone: 'surface',
      sizes: '(min-width: 960px) 50vw, 100vw'
    %}
  </div>
  <div class="lookbook__panel">
    {%- if section.settings.eyebrow != blank -%}
      <span class="lookbook__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <div class="lookbook__copy">
      <h2 class="display display--lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="lookbook__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ lookbook_url }}" class="btn btn--invert lookbook__btn">{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 18, stroke: 2.5 %}</a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.lookbook {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr));
}
.lookbook__media .media {
  height: 100%;
  min-height: 640px;
  border: 0;
  border-radius: 0;
}
.lookbook__panel {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 48px;
  min-width: 0;
  padding: calc(var(--lookbook-pt) * 0.6px) clamp(16px, 4vw, 72px) calc(var(--lookbook-pb) * 0.6px);
  background: var(--accent);
  color: var(--on-accent);
}
.lookbook__eyebrow {
  font-family: var(--f-mono);
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.lookbook__copy {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.lookbook__copy .display {
  font-size: clamp(44px, 5.5vw, 88px);
}
.lookbook__text {
  max-width: 460px;
  font-size: 19px;
  line-height: 1.5;
}
.lookbook__btn {
  align-self: start;
}
@media (min-width: 750px) {
  .lookbook__panel {
    padding-top: calc(var(--lookbook-pt) * 1px);
    padding-bottom: calc(var(--lookbook-pb) * 1px);
  }
}
.lookbook__copy .display em {
  display: inline-block;
  font-style: normal;
  padding: 0 0.12em;
  background: var(--on-accent);
  color: var(--accent);
  border-radius: var(--r);
}
@media (min-width: 960px) {
  .lookbook--right .lookbook__media {
    order: 2;
  }
}
@media (max-width: 767px) {
  .lookbook__media .media {
    min-height: 420px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section-lookbook",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "1000 x 1200px .jpg recommended" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Subheading", "default": "Lookbook — Vol. 04" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Made for the after-hours." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>Shot after dark across the city. See how the new drop moves, then shop every look straight from the page.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the lookbook" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Links to all products when empty." },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [
    {
      "name": "Lookbook"
    }
  ]
}
{% endschema %}
