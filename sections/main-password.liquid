{%- liquid
  assign logo = section.settings.logo
  assign logo_alt = logo.alt | default: shop.name
  assign admin_url = shop.url | append: '/admin'
-%}

<section class="pw color-{{ section.settings.color_scheme }}">
  <div class="pw__inner container">
    <header class="pw__header">
      {%- if logo != blank -%}
        {{
          logo
          | image_url: width: 480
          | image_tag: alt: logo_alt, loading: 'eager', fetchpriority: 'high', class: 'pw__logo', widths: '120,240,360,480', sizes: '240px'
        }}
      {%- else -%}
        <p class="pw__shop display">{{ shop.name }}</p>
      {%- endif -%}
    </header>

    <div class="pw__body">
      {%- if section.settings.heading != blank -%}
        <h1 class="display display--xl pw__title">{{ section.settings.heading }}</h1>
      {%- else -%}
        <h1 class="visually-hidden">{{ shop.name }}</h1>
      {%- endif -%}

      {%- if shop.password_message != blank -%}
        <div class="pw__message rte">{{ shop.password_message }}</div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="pw__block">
          <h2 class="pw__subheading">{{ section.settings.newsletter_heading }}</h2>
          {%- form 'customer', id: 'PasswordNewsletter', class: 'pw__form' -%}
            <input type="hidden" name="contact[tags]" value="prospect, password page">
            <div class="pw__row">
              <div class="field pw__field">
                <label for="PasswordNewsletter-email">{{ 'password_page.email_label' | t }}</label>
                <input
                  id="PasswordNewsletter-email"
                  class="input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  autocomplete="email"
                  required
                  aria-required="true"
                  {% if form.errors %}aria-invalid="true" aria-describedby="PasswordNewsletter-msg"{% endif %}
                >
              </div>
              <button type="submit" class="btn btn--accent">{{ 'password_page.subscribe' | t }}</button>
            </div>
            <div id="PasswordNewsletter-msg" role="status" aria-live="polite">
              {%- if form.posted_successfully? -%}
                <p class="form-message">{{ 'password_page.subscribe_success' | t }}</p>
              {%- elsif form.errors -%}
                <p class="form-message form-message--error" role="alert">{{ 'password_page.subscribe_error' | t }}</p>
              {%- endif -%}
            </div>
          {%- endform -%}
        </div>
      {%- endif -%}

      <div class="pw__block">
        <h2 class="pw__subheading">{{ 'password_page.enter_heading' | t }}</h2>
        {%- form 'storefront_password', class: 'pw__form' -%}
          <div class="pw__row">
            <div class="field pw__field">
              <label for="StorefrontPassword">{{ 'password_page.password_label' | t }}</label>
              <input
                id="StorefrontPassword"
                class="input"
                type="password"
                name="password"
                autocomplete="current-password"
                required
                aria-required="true"
                {% if form.errors %}aria-invalid="true" aria-describedby="StorefrontPassword-error"{% endif %}
              >
            </div>
            <button type="submit" class="btn btn--ink">{{ 'password_page.enter' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p id="StorefrontPassword-error" class="form-message form-message--error" role="alert">{{ 'password_page.wrong_password' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <footer class="pw__footer">
      {%- if section.settings.show_social -%}
        {% render 'social-links' %}
      {%- endif -%}
      <p class="pw__admin">
        {{ 'password_page.owner' | t }}
        <a href="{{ admin_url }}" rel="nofollow">{{ 'password_page.log_in' | t }}</a>
      </p>
    </footer>
  </div>
</section>

{% stylesheet %}
  .pw {
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
  }

  .pw__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 6vw, 72px);
    min-height: 100vh;
    padding-block: clamp(24px, 4vw, 48px);
  }

  .pw__logo {
    width: auto;
    max-width: min(240px, 60vw);
    height: auto;
  }

  .pw__shop {
    margin: 0;
    font-size: clamp(24px, 3vw, 36px);
  }

  .pw__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: clamp(24px, 4vw, 40px);
    max-width: 640px;
  }

  .pw__title {
    margin: 0;
  }

  .pw__message {
    font-size: 18px;
    line-height: 1.55;
  }

  .pw__block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 24px;
    border-top: 2px solid var(--fg);
  }

  .pw__subheading {
    margin: 0;
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pw__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pw__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px;
  }

  .pw__field {
    flex: 1 1 240px;
  }

  .pw__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .pw__admin {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .pw__admin a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg);
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "The shop name is shown when no logo is selected." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." },
    { "type": "header", "content": "Email signup" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Signup heading", "default": "Get notified at launch" },
    { "type": "header", "content": "Footer" },
    { "type": "checkbox", "id": "show_social", "label": "Show social media icons", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
