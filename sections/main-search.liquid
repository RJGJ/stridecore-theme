{%- liquid
  assign search_types = 'product'
  if section.settings.include_content
    assign search_types = 'product,page,article'
  endif
  assign popular = section.settings.popular_terms | split: ','
  assign has_terms = false
  if search.terms != blank
    assign has_terms = true
  endif
-%}

<script src="{{ 'predictive-search.js' | asset_url }}" defer></script>

<section class="srch-bar">
  <div class="container srch-bar__inner">
    <predictive-search
      class="srch-predictive"
      data-section-id="predictive-search"
      data-url="{{ routes.predictive_search_url }}"
    >
      <form action="{{ routes.search_url }}" method="get" role="search" class="srch-form">
        <label for="SearchInput-{{ section.id }}" class="eyebrow srch-label">{{ 'search.label' | t }}</label>
        <div class="srch-field">
          {% render 'icon', name: 'search', size: 44, stroke: 2.4 %}
          <input
            id="SearchInput-{{ section.id }}"
            class="srch-input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.placeholder | escape }}"
            enterkeyhint="search"
          >
          <input type="hidden" name="type" value="{{ search_types }}">
          <input type="hidden" name="options[prefix]" value="last">
          {%- if has_terms -%}
            <a href="{{ routes.search_url }}" class="srch-clear" aria-label="{{ 'search.clear' | t }}">
              {% render 'icon', name: 'close', size: 24, stroke: 2.5 %}
            </a>
          {%- endif -%}
          <button type="submit" class="visually-hidden">{{ 'search.submit' | t }}</button>
        </div>
        <div
          id="PredictivePanel-{{ section.id }}"
          class="ps-panel"
          role="listbox"
          aria-label="{{ 'search.suggestions' | t }}"
          data-predictive-panel
          hidden
        ></div>
        <p class="visually-hidden" role="status" aria-live="polite" data-predictive-live></p>
      </form>
    </predictive-search>

    {%- if popular.size > 0 -%}
      <div class="srch-popular">
        <span class="eyebrow">{{ 'search.popular' | t }}</span>
        {%- for term in popular -%}
          {%- assign term_clean = term | strip -%}
          {%- if term_clean != blank -%}
            {%- assign term_encoded = term_clean | url_encode -%}
            <a href="{{ routes.search_url }}?q={{ term_encoded }}&type={{ search_types | url_encode }}" class="pill srch-pill">{{ term_clean }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<section class="container srch-results">
  {%- paginate search.results by section.settings.per_page -%}
    {%- if search.performed -%}
      <p class="srch-summary" role="status">
        {{- 'search.results_for' | t: count: search.results_count, terms: search.terms -}}
      </p>
    {%- endif -%}

    {%- if search.performed and search.results_count > 0 -%}
      {%- assign has_products = false -%}
      {%- assign has_content = false -%}
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {%- assign has_products = true -%}
        {%- else -%}
          {%- assign has_content = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_products -%}
        <div class="product-grid srch-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 45vw, 100vw' %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if has_content -%}
        <ul class="srch-list">
          {%- for item in search.results -%}
            {%- if item.object_type != 'product' -%}
              {%- liquid
                assign item_body = item.content | strip_html | truncate: 140
                if item.object_type == 'article' and item.excerpt != blank
                  assign item_body = item.excerpt | strip_html | truncate: 140
                endif
              -%}
              <li>
                <a href="{{ item.url }}" class="srch-item">
                  <span class="srch-item__text">
                    <span class="srch-item__title">{{ item.title }}</span>
                    {%- if item_body != blank -%}
                      <span class="muted">{{ item_body }}</span>
                    {%- endif -%}
                  </span>
                  {% render 'icon', name: 'arrow-right', size: 24 %}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- elsif search.performed -%}
      <div class="srch-empty">
        <h2 class="display display--md">
          {{- 'search.empty_title_before' | t }}
          <span class="highlight">{{ 'search.empty_title_highlight' | t }}</span>.
        </h2>
        <p class="muted">{{ 'search.empty_text' | t }}</p>
        {%- if popular.size > 0 -%}
          <ul class="srch-suggest">
            {%- for term in popular -%}
              {%- assign term_clean = term | strip -%}
              {%- if term_clean != blank -%}
                {%- assign term_encoded = term_clean | url_encode -%}
                <li><a href="{{ routes.search_url }}?q={{ term_encoded }}&type={{ search_types | url_encode }}" class="pill">{{ term_clean }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--accent">{{ 'search.browse_all' | t }}</a>
      </div>
    {%- else -%}
      <p class="srch-summary muted">{{ 'search.prompt' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% stylesheet %}
  .srch-bar { border-bottom: 2px solid var(--fg); }
  .srch-bar__inner { display: flex; flex-direction: column; gap: 24px; padding-top: clamp(32px, 5vw, 72px); padding-bottom: clamp(28px, 4vw, 48px); }
  .srch-predictive { display: block; position: relative; }
  .srch-form { position: relative; display: flex; flex-direction: column; gap: 24px; }
  .srch-field { display: flex; align-items: center; gap: 16px; border-bottom: 4px solid var(--fg); padding-bottom: 8px; }
  .srch-field > svg { flex: none; width: clamp(28px, 4vw, 44px); height: clamp(28px, 4vw, 44px); }
  .srch-input { flex: 1; min-width: 0; padding: 0; background: transparent; border: 0; border-radius: 0; color: var(--fg); font-family: var(--f-display); font-weight: var(--d-weight); font-stretch: var(--d-stretch); font-size: clamp(36px, 6vw, 88px); letter-spacing: var(--d-track); text-transform: var(--h-case); outline-offset: 6px; -webkit-appearance: none; appearance: none; }
  .srch-input::placeholder { color: var(--muted); opacity: 0.6; }
  .srch-input::-webkit-search-cancel-button { display: none; }
  .srch-clear { flex: none; display: grid; place-items: center; width: 52px; height: 52px; background: var(--fg); color: var(--bg); border-radius: var(--r-pill); text-decoration: none; }
  .srch-popular { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .srch-pill { text-transform: uppercase; letter-spacing: 0.04em; }

  .srch-results { padding-top: 32px; padding-bottom: clamp(64px, 8vw, 112px); }
  .srch-summary { margin-bottom: 32px; font-size: 18px; font-weight: 700; }
  .srch-grid { grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 40px 20px; }
  .srch-list { margin: 40px 0 0; padding: 0; list-style: none; border-top: 2px solid var(--fg); }
  .srch-list li { border-bottom: 1px solid var(--line); }
  .srch-item { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 44px; padding: 24px 0; text-decoration: none; }
  .srch-item__text { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .srch-item__title { font-weight: 800; font-size: 20px; text-transform: uppercase; }
  .srch-empty { display: flex; flex-direction: column; align-items: start; gap: 20px; padding: clamp(24px, 4vw, 56px) 0; }
  .srch-empty p { max-width: 480px; font-size: 17px; line-height: 1.5; }
  .srch-suggest { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; list-style: none; }

  /* Predictive dropdown (markup from sections/predictive-search.liquid) */
  .ps-panel { position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 30; max-height: min(70vh, 640px); overflow-y: auto; background: var(--bg); color: var(--fg); border: 2px solid var(--fg); border-radius: var(--r); box-shadow: var(--shadow); }
  .ps-panel[hidden] { display: none; }
  .ps-group { padding: 12px 0 4px; }
  .ps-heading { margin: 0; padding: 0 20px 6px; font-family: var(--f-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .ps-list { margin: 0; padding: 0; list-style: none; }
  .ps-link { display: flex; align-items: center; gap: 14px; min-height: 48px; padding: 6px 20px; text-decoration: none; font-size: 16px; font-weight: 700; }
  .ps-link:hover { opacity: 1; }
  .ps-link.is-active, .ps-link:hover, .ps-all.is-active, .ps-all:hover { background: var(--fg); color: var(--bg); }
  .ps-link__title { flex: 1; min-width: 0; text-transform: uppercase; overflow-wrap: anywhere; }
  .ps-link__price { flex: none; font-size: 14px; }
  .ps-thumb { flex: none; width: 56px; }
  .ps-thumb .media { border-radius: var(--r-img); }
  .ps-thumb .media--placeholder > span { display: none; }
  .ps-all { display: flex; justify-content: space-between; align-items: center; min-height: 52px; padding: 0 20px; border-top: 2px solid var(--fg); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; font-size: 14px; text-decoration: none; }
  .ps-all:hover { opacity: 1; }
  .ps-empty { margin: 0; padding: 20px; color: var(--muted); }
{% endstylesheet %}

{% schema %}
{
  "name": "Search page",
  "tag": "section",
  "class": "section-main-search",
  "settings": [
    { "type": "text", "id": "placeholder", "label": "Search placeholder", "default": "Hoodies, cargo, caps…" },
    { "type": "text", "id": "popular_terms", "label": "Popular searches", "info": "Comma separated.", "default": "Hoodie, Cargo, Tee, Cap, Jacket" },
    { "type": "checkbox", "id": "include_content", "label": "Include pages and articles in results", "default": false },
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 4, "max": 48, "step": 4, "default": 12 }
  ],
  "presets": [
    { "name": "Search page" }
  ]
}
{% endschema %}
