{%- if settings.cart_type == 'drawer' -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
    assign shipping_pct = 100
    assign shipping_unlocked = false
    if threshold > 0
      assign shipping_pct = cart.total_price | times: 100.0 | divided_by: threshold | round | at_most: 100
      if cart.total_price >= threshold
        assign shipping_unlocked = true
      else
        assign remaining_cents = threshold | minus: cart.total_price
        assign remaining_money = remaining_cents | money
      endif
    endif
    assign drawer_title = 'chrome.drawer.title' | t: count: cart.item_count
  -%}
  <cart-drawer
    class="cart-drawer color-{{ section.settings.color_scheme }}"
    data-cart-drawer
    data-section-id="{{ section.id }}"
    data-msg-updated="{{ 'chrome.drawer.updated' | t | escape }}"
    data-msg-error="{{ 'chrome.drawer.error' | t | escape }}"
    data-msg-max="{{ 'cart_page.max_reached' | t | escape }}"
    hidden
  >
    <div class="cart-drawer__backdrop" data-drawer-close></div>
    <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" tabindex="-1" data-drawer-panel>
      <div class="cart-drawer__head">
        <h2 class="cart-drawer__title display" id="cart-drawer-title" data-drawer-title>{{ drawer_title }}</h2>
        <button type="button" class="icon-btn" aria-label="{{ 'chrome.drawer.close' | t }}" data-drawer-close>{% render 'icon', name: 'close' %}</button>
      </div>

      <p class="cart-drawer__error" role="alert" data-drawer-error hidden></p>

      <div class="cart-drawer__content" data-drawer-content>
        {%- if cart.item_count > 0 -%}
          {%- if threshold > 0 -%}
            <div class="cart-drawer__shipping" data-shipping-meter>
              <p class="cart-drawer__shipping-msg" id="cart-drawer-shipping-msg">
                {%- if shipping_unlocked -%}
                  {{ 'chrome.drawer.shipping_unlocked' | t }}
                {%- else -%}
                  {{ 'chrome.drawer.shipping_away' | t: amount: remaining_money }}
                {%- endif -%}
              </p>
              <div class="cart-drawer__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ shipping_pct }}" aria-labelledby="cart-drawer-shipping-msg">
                <div class="cart-drawer__bar-fill" data-bar-fill style="width: {{ shipping_pct }}%"></div>
              </div>
            </div>
          {%- endif -%}

          <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm-{{ section.id }}" class="cart-drawer__form" novalidate>
            <div class="cart-drawer__body">
              <ul class="cart-drawer__list" role="list">
                {%- for item in cart.items -%}
                  <li class="cart-drawer__item" data-line-key="{{ item.key }}" data-line="{{ forloop.index }}">
                    <a href="{{ item.url }}" class="cart-drawer__thumb" aria-hidden="true" tabindex="-1">
                      {% render 'placeholder-media',
                        image: item.image,
                        ratio: '4 / 5',
                        label: item.product.title,
                        sizes: '96px',
                        widths: '96,192,288'
                      %}
                    </a>
                    <div class="cart-drawer__info">
                      <div class="cart-drawer__row">
                        <div class="cart-drawer__meta">
                          <a href="{{ item.url }}" class="cart-drawer__name">{{ item.product.title }}</a>
                          {% render 'cart-line-details', item: item %}
                        </div>
                        {% render 'cart-line-price', item: item %}
                      </div>
                      <div class="cart-drawer__controls">
                        {% render 'cart-line-quantity', item: item, index: forloop.index, id_prefix: section.id %}
                        <button type="button" class="cart-drawer__remove" data-remove aria-label="{{ 'cart_page.remove_item' | t: title: item.product.title }}">{{ 'cart_page.remove' | t }}</button>
                      </div>
                      {%- if item.error_message != blank -%}
                        <p class="cart-drawer__line-error" role="alert">{{ item.error_message }}</p>
                      {%- endif -%}
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            </div>

            <div class="cart-drawer__foot">
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="cart-drawer__discount">
                  <span>{{ discount.title }}</span>
                  <span>-{{ discount.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}

              <div class="cart-drawer__subtotal">
                <span>{{ 'cart_page.total' | t }}</span>
                <span class="mono cart-drawer__subtotal-price" data-cart-total>{{ cart.total_price | money }}</span>
              </div>
              <p class="cart-drawer__note">
                {%- if cart.taxes_included -%}
                  {{ 'chrome.drawer.taxes_included_note' | t }}
                {%- else -%}
                  {{ 'chrome.drawer.taxes_note' | t }}
                {%- endif -%}
              </p>

              {%- if section.settings.show_order_note -%}
                <div class="field cart-drawer__order-note">
                  <label for="CartDrawerNote-{{ section.id }}">{{ 'cart_page.order_note' | t }}</label>
                  <textarea id="CartDrawerNote-{{ section.id }}" name="note" class="input" rows="2" placeholder="{{ 'cart_page.order_note_placeholder' | t }}">{{ cart.note }}</textarea>
                </div>
              {%- endif -%}

              <button type="submit" name="checkout" class="btn btn--accent btn--block">
                {% render 'icon', name: 'arrow-right', size: 18, stroke: 2.5 %}{{ 'chrome.drawer.checkout' | t }}
              </button>
              {%- if additional_checkout_buttons and section.settings.show_accelerated_checkout -%}
                <div class="cart-drawer__accelerated">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
              <a href="{{ routes.cart_url }}" class="cart-drawer__view">{{ 'chrome.drawer.view_cart' | t }}</a>
            </div>
          </form>
        {%- else -%}
          <div class="cart-drawer__body">
            <div class="cart-drawer__empty">
              <p class="cart-drawer__empty-heading display">{{ 'chrome.drawer.empty_heading' | t }}</p>
              <p class="muted">{{ 'chrome.drawer.empty_text' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--ink">{{ 'chrome.drawer.continue_shopping' | t }}</a>
            </div>
          </div>
        {%- endif -%}
      </div>

      <p class="visually-hidden" role="status" aria-live="polite" data-drawer-live></p>
    </div>
  </cart-drawer>

  <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
{%- endif -%}

{% stylesheet %}
  .cart-drawer__backdrop {
    position: fixed;
    inset: 0;
    z-index: 900;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .cart-drawer__panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 901;
    width: min(460px, 100vw);
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--fg);
    border-left: 2px solid var(--fg);
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    outline: none;
  }
  .cart-drawer.is-open .cart-drawer__backdrop {
    opacity: 1;
  }
  .cart-drawer.is-open .cart-drawer__panel {
    transform: none;
  }
  .cart-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 2px solid var(--fg);
  }
  .cart-drawer__title {
    font-size: 28px;
  }
  .cart-drawer__shipping {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
  }
  .cart-drawer__shipping-msg {
    font-weight: 700;
    font-size: 15px;
  }
  .cart-drawer__bar {
    height: 14px;
    background: var(--surface);
    border: 2px solid var(--fg);
    border-radius: var(--r-pill);
    overflow: hidden;
  }
  .cart-drawer__bar-fill {
    height: 100%;
    width: 0;
    background: var(--accent);
    border-right: 2px solid var(--fg);
    transition: width 0.4s;
  }
  .cart-drawer__content,
  .cart-drawer__form {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }
  .cart-drawer__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 20px;
  }
  .cart-drawer__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .cart-drawer__error,
  .cart-drawer__line-error {
    margin: 0;
    color: var(--accent-ink);
    font-size: 14px;
    font-weight: 700;
  }
  .cart-drawer__error {
    padding: 10px 20px;
    border-bottom: 1px solid var(--line);
  }
  .cart-drawer__discount {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--accent-ink);
    font-size: 14px;
    font-weight: 700;
  }
  .cart-drawer__order-note label {
    font-family: var(--f-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
  }
  .cart-drawer__order-note .input {
    min-height: 0;
    padding: 10px;
    font-size: 14px;
    resize: vertical;
  }
  .cart-drawer__accelerated {
    min-width: 0;
  }
  .cart-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cart-drawer__item {
    display: flex;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .cart-drawer__thumb {
    flex: none;
    width: 96px;
    text-decoration: none;
  }
  .cart-drawer__thumb .media {
    width: 100%;
  }
  .cart-drawer__thumb .media--placeholder {
    border-width: 2px;
  }
  .cart-drawer__info {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
  }
  .cart-drawer__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .cart-drawer__name {
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .cart-drawer__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .cart-drawer__remove {
    min-height: 44px;
    min-width: 44px;
    cursor: pointer;
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    font-size: 14px;
    font-weight: 700;
    text-decoration: underline;
  }
  .cart-drawer__item[aria-busy="true"],
  .cart-drawer__content[aria-busy="true"] .cart-drawer__form {
    opacity: 0.5;
    pointer-events: none;
  }
  .cart-drawer__foot {
    flex: none;
    max-height: 60vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    background: var(--surface);
    border-top: 2px solid var(--fg);
  }
  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-weight: 800;
    font-size: 18px;
    text-transform: uppercase;
  }
  .cart-drawer__subtotal-price {
    font-size: 24px;
  }
  .cart-drawer__info .cart-line-price {
    flex: none;
  }
  .cart-drawer__note {
    font-size: 13px;
    color: var(--muted);
  }
  .cart-drawer__view {
    text-align: center;
    font-weight: 700;
    font-size: 14px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 40px 0;
  }
  .cart-drawer__empty-heading {
    font-size: clamp(36px, 10vw, 52px);
  }
  body.cart-drawer-open {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-drawer__backdrop,
    .cart-drawer__panel,
    .cart-drawer__bar-fill {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart drawer",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Only shown when cart type is set to drawer in theme settings. The free shipping meter uses the threshold from theme settings."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "Show order note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_accelerated_checkout",
      "label": "Show accelerated checkout buttons",
      "info": "Displays the payment buttons enabled in your payment settings, such as Shop Pay.",
      "default": true
    }
  ]
}
{% endschema %}
