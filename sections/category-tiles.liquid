{%- liquid
  assign tiles_eager = false
  if section.index < 3
    assign tiles_eager = true
  endif
-%}

<div
  class="category-tiles color-{{ section.settings.color_scheme }}"
  style="--tiles-pt: {{ section.settings.padding_top }}; --tiles-pb: {{ section.settings.padding_bottom }};"
>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="display display--md category-tiles__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="category-tiles__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = block.settings.collection
        assign tile_title = block.settings.title
        if tile_title == blank
          assign tile_title = collection.title
        endif
        assign tile_url = collection.url
        if tile_url == blank
          assign tile_url = routes.all_products_collection_url
        endif
        assign tile_number = forloop.index | plus: 100 | append: '' | slice: 1, 2
        assign tile_alt = block.settings.image.alt | default: tile_title
        assign tile_loading = 'lazy'
        if tiles_eager and forloop.first
          assign tile_loading = 'eager'
        endif
      -%}
      <a href="{{ tile_url }}" class="tile tile--{{ block.settings.tone }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="tile__bg">
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: tile_loading, sizes: '(min-width: 1024px) 33vw, (min-width: 750px) 50vw, 100vw', widths: '400,600,800,1000', alt: tile_alt }}
          </div>
        {%- else -%}
          <div class="tile__bg stripes"></div>
        {%- endif -%}
        <div class="tile__content">
          <div class="tile__top">
            <span aria-hidden="true">{{ tile_number }}</span>
            {%- if block.settings.image == blank -%}
              <span aria-hidden="true">{{ 'home.tiles.category_image' | t }}</span>
            {%- endif -%}
          </div>
          <div class="tile__bottom">
            <span class="tile__name">{{ tile_title }}</span>
            <span class="tile__arrow">{% render 'icon', name: 'arrow-up-right', size: 20, stroke: 2.5 %}</span>
          </div>
        </div>
      </a>
    {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.category-tiles {
  padding-top: calc(var(--tiles-pt) * 0.6px);
  padding-bottom: calc(var(--tiles-pb) * 0.6px);
}
@media (min-width: 750px) {
  .category-tiles {
    padding-top: calc(var(--tiles-pt) * 1px);
    padding-bottom: calc(var(--tiles-pb) * 1px);
  }
}
.category-tiles__heading {
  margin-bottom: 32px;
}
.category-tiles__heading em {
  display: inline-block;
  padding: 0 0.12em;
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--r);
  font-style: normal;
}
.category-tiles__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  gap: 20px;
}
.tile {
  position: relative;
  display: block;
  aspect-ratio: 3 / 4;
  border: 2px solid var(--fg);
  border-radius: var(--r-img);
  overflow: hidden;
  text-decoration: none;
  --tile-bg: var(--accent);
  --tile-fg: var(--on-accent);
}
.tile--surface {
  --tile-bg: var(--surface);
  --tile-fg: var(--fg);
}
.tile--fg {
  --tile-bg: var(--fg);
  --tile-fg: var(--bg);
}
.tile__bg {
  position: absolute;
  inset: 0;
  background-color: var(--tile-bg);
}
.tile__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.tile__content {
  position: absolute;
  inset: 0;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: var(--tile-fg);
}
.tile__top {
  display: flex;
  justify-content: space-between;
  font-family: var(--f-mono);
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.tile__bottom {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 12px;
}
.tile__name {
  min-width: 0;
  font-family: var(--f-display);
  font-weight: var(--d-weight);
  font-stretch: var(--d-stretch);
  font-size: clamp(40px, 4.2vw, 64px);
  line-height: var(--d-lead);
  text-transform: var(--h-case);
  letter-spacing: var(--d-track);
  overflow-wrap: break-word;
  transition: letter-spacing 0.4s;
}
.tile:hover {
  opacity: 1;
}
.tile:hover .tile__name {
  letter-spacing: 0.03em;
}
.tile__arrow {
  width: 52px;
  height: 52px;
  flex: none;
  display: grid;
  place-items: center;
  border: 2px solid currentColor;
  border-radius: 50%;
}
@media (prefers-reduced-motion: reduce) {
  .tile__name {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "class": "section-category-tiles",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 0 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Heading", "info": "Uses the collection title when empty." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "3:4 aspect ratio recommended" },
        {
          "type": "select",
          "id": "tone",
          "label": "Tile color",
          "options": [
            { "value": "accent", "label": "Accent" },
            { "value": "surface", "label": "Surface" },
            { "value": "fg", "label": "Inverse" }
          ],
          "default": "accent"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Tops", "tone": "accent" } },
        { "type": "tile", "settings": { "title": "Bottoms", "tone": "surface" } },
        { "type": "tile", "settings": { "title": "Outerwear", "tone": "fg" } }
      ]
    }
  ]
}
{% endschema %}
