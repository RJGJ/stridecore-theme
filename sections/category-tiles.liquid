<section class="container category-tiles">
  <div class="category-tiles__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = block.settings.collection
        assign tile_title = block.settings.title
        if tile_title == blank
          assign tile_title = collection.title
        endif
        assign tile_url = collection.url
        if tile_url == blank
          assign tile_url = routes.all_products_collection_url
        endif
        assign tile_number = forloop.index | plus: 100 | append: '' | slice: 1, 2
      -%}
      <a href="{{ tile_url }}" class="tile tile--{{ block.settings.tone }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="tile__bg">
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 33vw, 100vw', widths: '400,600,800,1000' }}
          </div>
        {%- else -%}
          <div class="tile__bg stripes"></div>
        {%- endif -%}
        <div class="tile__content">
          <div class="tile__top">
            <span>{{ tile_number }}</span>
            {%- if block.settings.image == blank -%}
              <span>{{ 'home.tiles.category_image' | t }}</span>
            {%- endif -%}
          </div>
          <div class="tile__bottom">
            <span class="tile__name">{{ tile_title }}</span>
            <span class="tile__arrow">{% render 'icon', name: 'arrow-up-right', size: 20, stroke: 2.5 %}</span>
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.category-tiles {
  padding-top: clamp(48px, 6vw, 96px);
}
.category-tiles__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  gap: 20px;
}
.tile {
  position: relative;
  display: block;
  aspect-ratio: 3 / 4;
  border: 2px solid var(--fg);
  border-radius: var(--r-img);
  overflow: hidden;
  text-decoration: none;
  --tile-bg: var(--accent);
  --tile-fg: var(--on-accent);
}
.tile--surface {
  --tile-bg: var(--surface);
  --tile-fg: var(--fg);
}
.tile--fg {
  --tile-bg: var(--fg);
  --tile-fg: var(--bg);
}
.tile__bg {
  position: absolute;
  inset: 0;
  background-color: var(--tile-bg);
}
.tile__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.tile__content {
  position: absolute;
  inset: 0;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: var(--tile-fg);
}
.tile__top {
  display: flex;
  justify-content: space-between;
  font-family: var(--f-mono);
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.tile__bottom {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 12px;
}
.tile__name {
  min-width: 0;
  font-family: var(--f-display);
  font-weight: var(--d-weight);
  font-stretch: var(--d-stretch);
  font-size: clamp(40px, 4.2vw, 64px);
  line-height: var(--d-lead);
  text-transform: var(--h-case);
  letter-spacing: var(--d-track);
  overflow-wrap: break-word;
  transition: letter-spacing 0.4s;
}
.tile:hover {
  opacity: 1;
}
.tile:hover .tile__name {
  letter-spacing: 0.03em;
}
.tile__arrow {
  width: 52px;
  height: 52px;
  flex: none;
  display: grid;
  place-items: center;
  border: 2px solid currentColor;
  border-radius: 50%;
}
@media (prefers-reduced-motion: reduce) {
  .tile__name {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "class": "section-category-tiles",
  "settings": [],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override", "info": "Leave blank to use the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "tone",
          "label": "Color tone",
          "options": [
            { "value": "accent", "label": "Accent" },
            { "value": "surface", "label": "Surface" },
            { "value": "fg", "label": "Foreground" }
          ],
          "default": "accent"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Tops", "tone": "accent" } },
        { "type": "tile", "settings": { "title": "Bottoms", "tone": "surface" } },
        { "type": "tile", "settings": { "title": "Outerwear", "tone": "fg" } }
      ]
    }
  ]
}
{% endschema %}
