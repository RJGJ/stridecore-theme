{%- liquid
  assign fc_collection = section.settings.collection
  assign fc_limit = section.settings.products_to_show
  assign fc_columns = section.settings.columns_desktop
  assign fc_view_all_url = fc_collection.url
  if fc_view_all_url == blank
    assign fc_view_all_url = routes.all_products_collection_url
  endif
  assign fc_vw = 100 | divided_by: fc_columns
  assign fc_card_sizes = '(min-width: 1024px) ' | append: fc_vw | append: 'vw, 50vw'
  assign fc_ratio = section.settings.image_ratio
-%}

<div
  class="fc color-{{ section.settings.color_scheme }}"
  style="--fc-pt: {{ section.settings.padding_top }}; --fc-pb: {{ section.settings.padding_bottom }}; --fc-cols: {{ fc_columns }}; --fc-cols-mobile: {{ section.settings.columns_mobile }};"
>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="fc__head">
        <h2 class="display display--md fc__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if fc_collection != blank and fc_collection.products.size > 0 -%}
      <ul class="fc__grid" role="list">
        {%- for product in fc_collection.products limit: fc_limit -%}
          {%- liquid
            assign card_tone = 'surface'
            if forloop.index0 == 0
              assign card_tone = 'accent'
            endif
            assign card_loading = 'lazy'
            if section.index == 1 and forloop.index <= fc_columns
              assign card_loading = 'eager'
            endif
          -%}
          <li class="fc__item">
            {% render 'product-card',
              product: product,
              ratio: fc_ratio,
              tone: card_tone,
              sizes: fc_card_sizes,
              loading: card_loading
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="fc__grid" role="list">
        {%- for i in (1..fc_columns) -%}
          {%- assign placeholder_name = 'product-' | append: i -%}
          <li class="fc__item">
            <div class="card">
              <div class="media media--placeholder fc__placeholder" style="aspect-ratio: {{ fc_ratio }}">
                {{ placeholder_name | placeholder_svg_tag: 'fc__placeholder-svg' }}
              </div>
              <div class="card__info">
                <span class="card__title">{{ 'home.featured.placeholder_title' | t }}</span>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div class="fc__block" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when '@app' -%}
            {%- render block -%}
          {%- when 'custom_liquid' -%}
            {{ block.settings.custom_liquid }}
        {%- endcase -%}
      </div>
    {%- endfor -%}

    {%- if section.settings.show_view_all and section.settings.button_label != blank -%}
      <div class="fc__more">
        <a href="{{ fc_view_all_url }}" class="btn btn--outline">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.fc {
  padding-top: calc(var(--fc-pt) * 0.6px);
  padding-bottom: calc(var(--fc-pb) * 0.6px);
}
.fc__head {
  display: flex;
  flex-wrap: wrap;
  align-items: end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 32px;
}
.fc__heading em {
  display: inline-block;
  padding: 0 0.12em;
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--r);
  font-style: normal;
}
.fc__grid {
  display: grid;
  grid-template-columns: repeat(var(--fc-cols-mobile), minmax(0, 1fr));
  gap: 32px 16px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.fc__item {
  min-width: 0;
}
.fc__placeholder {
  color: var(--muted);
}
.fc__placeholder-svg {
  width: 100%;
  height: 100%;
  fill: currentColor;
}
.fc__block {
  margin-top: 32px;
}
.fc__more {
  display: flex;
  justify-content: center;
  margin-top: 40px;
}
@media (min-width: 750px) {
  .fc {
    padding-top: calc(var(--fc-pt) * 1px);
    padding-bottom: calc(var(--fc-pb) * 1px);
  }
  .fc__grid {
    grid-template-columns: repeat(min(var(--fc-cols), 3), minmax(0, 1fr));
    gap: 40px 24px;
  }
}
@media (min-width: 1024px) {
  .fc__grid {
    grid-template-columns: repeat(var(--fc-cols), minmax(0, 1fr));
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Maximum products to show", "default": 4 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "One column" },
        { "value": "2", "label": "Two columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 2", "label": "Landscape" }
      ],
      "default": "4 / 5"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "custom_liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Liquid",
          "info": "Add app snippets or custom Liquid code to create advanced customizations."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
