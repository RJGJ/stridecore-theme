{%- liquid
  assign home_link = section.settings.button_link | default: routes.root_url
  assign shop_link = routes.all_products_collection_url
-%}

<section class="nf container">
  <div class="nf__digits display" aria-hidden="true">
    <span>4</span>
    <span class="nf__zero">
      <svg width="50%" height="50%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" focusable="false"><circle cx="8.5" cy="10" r="1.3" fill="currentColor"></circle><circle cx="15.5" cy="10" r="1.3" fill="currentColor"></circle><path d="M8 16.5c1.2-1.3 2.5-1.9 4-1.9s2.8.6 4 1.9"></path></svg>
    </span>
    <span>4</span>
  </div>

  <h1 class="display nf__title">{{ section.settings.heading }}</h1>
  {%- if section.settings.text != blank -%}
    <p class="nf__text">{{ section.settings.text }}</p>
  {%- endif -%}

  <form class="nf__search" action="{{ routes.search_url }}" method="get" role="search">
    <label for="NotFoundSearch" class="visually-hidden">{{ 'not_found.search_label' | t }}</label>
    <input id="NotFoundSearch" class="input nf__input" type="search" name="q" placeholder="{{ 'not_found.search_label' | t }}" autocomplete="off">
    <button type="submit" class="btn btn--ink">{{ 'general.search' | t }}</button>
  </form>

  <div class="nf__actions">
    <a href="{{ home_link }}" class="btn btn--accent">{{ section.settings.button_label | default: 'Back to home' }}</a>
    <a href="{{ shop_link }}" class="btn">{{ 'not_found.shop_all' | t }}</a>
  </div>
</section>

{%- if section.settings.ticker_text != blank -%}
  <div class="nf-ticker">
    {% render 'marquee',
      items: section.settings.ticker_text,
      reverse: true,
      gap: '36px',
      class: 'display nf-ticker__track',
      separator_class: 'nf-ticker__sep'
    %}
  </div>
{%- endif -%}

{% stylesheet %}
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding-block: clamp(48px, 7vw, 112px);
    text-align: center;
  }

  .nf__digits {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.04em;
    font-size: clamp(140px, 26vw, 400px);
    line-height: 0.8;
    text-transform: none;
  }

  .nf__zero {
    display: inline-grid;
    place-items: center;
    width: 0.82em;
    height: 0.82em;
    border: 0.03em solid var(--fg);
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    transform-origin: 50% 60%;
    animation: nf-wob 3.2s ease-in-out infinite;
  }

  @keyframes nf-wob {
    0%,
    100% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(4deg);
    }
  }

  .nf__title {
    font-size: clamp(36px, 4.5vw, 68px);
  }

  .nf__text {
    max-width: 480px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.55;
  }

  .nf__search {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    max-width: 560px;
  }

  .nf__input {
    flex: 1 1 260px;
    width: auto;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  .nf-ticker {
    padding: 16px 0;
    border-block: 2px solid var(--fg);
    background: var(--fg);
    color: var(--bg);
    overflow: hidden;
  }

  .nf-ticker__track {
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1.05;
  }

  .nf-ticker__sep {
    color: var(--accent-on-fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nf__zero {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page sold out." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The link may be broken or the page may have moved. Try a search, or head back to the shop."
    },
    { "type": "text", "id": "button_label", "label": "Home button label", "default": "Back to home" },
    { "type": "url", "id": "button_link", "label": "Home button link", "info": "Leave blank to use the home page." },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "info": "Separate items with \"|\". Leave blank to hide the ticker.",
      "default": "Lost? Keep shopping"
    }
  ]
}
{% endschema %}
