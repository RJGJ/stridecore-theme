{%- liquid
  assign limit = section.settings.limit
  assign has_items = false
  if recommendations.performed and recommendations.products_count > 0
    assign has_items = true
  endif
  assign recs_url = routes.product_recommendations_url
-%}

<section class="complementary container" aria-labelledby="complementary-{{ section.id }}"{% unless has_items %} hidden{% endunless %}>
  {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <div class="complementary__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="display display--md" id="complementary-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <product-recommendations
    data-url="{{ recs_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit={{ limit }}&amp;intent=complementary"
    data-loaded="{% if recommendations.performed %}true{% else %}false{% endif %}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="product-grid">
        {%- for item in recommendations.products limit: limit -%}
          {% render 'product-card', product: item, show_quick_add: section.settings.show_quick_add %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </product-recommendations>
</section>

<script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>

{% stylesheet %}
  .complementary {
    padding-block: clamp(48px, 6vw, 80px) 0;
  }
  .complementary__head {
    margin-bottom: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .complementary product-recommendations {
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Complementary products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Complete the look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs well with" },
    { "type": "range", "id": "limit", "label": "Number of products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add", "default": true }
  ],
  "presets": [{ "name": "Complementary products" }]
}
{% endschema %}
