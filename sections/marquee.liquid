{%- liquid
  assign marquee_items = ''
  for block in section.blocks
    if block.settings.text != blank
      assign marquee_text = block.settings.text | strip_html | strip
      assign marquee_items = marquee_items | append: marquee_text | append: '|'
    endif
  endfor
  assign marquee_items = marquee_items | remove_last: '|'
-%}

<div
  class="marquee-wrap color-{{ section.settings.color_scheme }}"
  style="--marquee-pt: {{ section.settings.padding_top }}px; --marquee-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="marquee-band">
    {% render 'marquee',
      items: marquee_items,
      reverse: true,
      gap: '40px',
      class: 'marquee-band__track',
      separator_class: 'marquee-band__sep'
    %}
  </div>
</div>

{% stylesheet %}
.marquee-wrap {
  padding-top: var(--marquee-pt);
  padding-bottom: var(--marquee-pb);
}
.marquee-band {
  overflow: hidden;
  padding: 18px 0;
  background: var(--fg);
  color: var(--bg);
  border-top: 2px solid var(--fg);
  border-bottom: 2px solid var(--fg);
}
.marquee-band__track {
  font-family: var(--f-display);
  font-weight: var(--d-weight);
  font-stretch: var(--d-stretch);
  font-size: clamp(48px, 7vw, 104px);
  line-height: 1.05;
  text-transform: var(--h-case);
  letter-spacing: var(--d-track);
}
.marquee-band__sep {
  color: var(--accent-on-fg);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Big marquee",
  "tag": "section",
  "class": "section-marquee",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 0 }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Built different" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Big marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "Built different" } },
        { "type": "text", "settings": { "text": "Worn louder" } }
      ]
    }
  ]
}
{% endschema %}
